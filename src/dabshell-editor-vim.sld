;; dabshell editor-vim: the modal vim key map of the editor (normal, insert,
;; visual and visual-line mode, counts, operators with motions, search,
;; and ex commands). It registers itself as the "vim" key map.

(define-library (dabshell editor-vim)
  (export vim-word-forward vim-word-end vim-word-back vim-substitute-line)
  (import (scheme base)
          (scheme char)
          (only (srfi 1) filter)
          (scm string)
          (dabshell util)
          (dabshell core)
          (dabshell editor-buffer)
          (dabshell editor-core))
  (begin

    ;; ------------------------------------------------------------------
    ;; words: classes space, word characters and punctuation

    (define (char-class ch big)
      (cond ((memv ch '(#\space #\tab #\newline)) 'space)
            ((or big (word-char? ch)) 'word)
            (else 'punct)))

    ;; 'w': start of the next word (an empty line also counts as a word)
    (define (vim-word-forward b r c big)
      (let ((cls (char-class (buffer-char-at b r c) big)))
        (let skip ((c c))
          (if (and (not (eq? cls 'space)) (eq? (char-class (buffer-char-at b r c) big) cls))
              (skip (+ c 1))
              (let loop ((r r) (c c))
                (let ((ch (buffer-char-at b r c)))
                  (cond ((char=? ch #\newline)
                         (cond ((>= r (buffer-last-row b)) (cons r c))
                               ((string=? (buffer-line b (+ r 1)) "") (cons (+ r 1) 0))
                               (else (loop (+ r 1) 0))))
                        ((memv ch '(#\space #\tab)) (loop r (+ c 1)))
                        (else (cons r c)))))))))

    ;; 'e': last character of the current/next word
    (define (vim-word-end b r c big)
      (let ((p (buffer-next-pos b r c)))
        (if (not p)
            (cons r c)
            (let skip ((r (car p)) (c (cdr p)))
              (if (eq? (char-class (buffer-char-at b r c) big) 'space)
                  (let ((p (buffer-next-pos b r c)))
                    (if p (skip (car p) (cdr p)) (cons r c)))
                  (let ((cls (char-class (buffer-char-at b r c) big))
                        (line (buffer-line b r)))
                    (let loop ((c c))
                      (if (and (< (+ c 1) (string-length line))
                               (eq? (char-class (string-ref line (+ c 1)) big) cls))
                          (loop (+ c 1))
                          (cons r c)))))))))

    ;; 'b': start of the current/previous word
    (define (vim-word-back b r c big)
      (let ((p (buffer-prev-pos b r c)))
        (if (not p)
            (cons r c)
            (let skip ((r (car p)) (c (cdr p)))
              (cond ((and (eq? (char-class (buffer-char-at b r c) big) 'space)
                          (= c 0) (string=? (buffer-line b r) ""))
                     (cons r c))
                    ((eq? (char-class (buffer-char-at b r c) big) 'space)
                     (let ((p (buffer-prev-pos b r c)))
                       (if p (skip (car p) (cdr p)) (cons r c))))
                    (else
                     (let ((cls (char-class (buffer-char-at b r c) big))
                           (line (buffer-line b r)))
                       (let loop ((c c))
                         (if (and (> c 0) (eq? (char-class (string-ref line (- c 1)) big) cls))
                             (loop (- c 1))
                             (cons r c))))))))))

    ;; ------------------------------------------------------------------
    ;; :s replacement and regular expressions (Python's re semantics)

    ;; a vim replacement (& = whole match) as a Python re template
    (define (vim-replacement repl)
      (let ((n (string-length repl)) (out (open-output-string)))
        (let loop ((i 0))
          (when (< i n)
            (let ((ch (string-ref repl i)))
              (cond ((and (char=? ch #\\) (< (+ i 1) n))
                     (let ((nxt (string-ref repl (+ i 1))))
                       (write-string (case nxt ((#\&) "&") ((#\n) "\\n") (else (string ch nxt))) out)
                       (loop (+ i 2))))
                    (else (write-string (if (char=? ch #\&) "\\g<0>" (string ch)) out)
                          (loop (+ i 1)))))))
        (get-output-string out)))

    ;; split at unescaped delim; \<delim> is a literal delimiter, other
    ;; escapes stay as they are
    (define (split-unescaped text delim)
      (let ((n (string-length text)))
        (let loop ((i 0) (cur '()) (parts '()))
          (define (cur-str) (list->string (reverse cur)))
          (cond ((>= i n) (reverse (cons (cur-str) parts)))
                ((and (char=? (string-ref text i) #\\) (< (+ i 1) n))
                 (loop (+ i 2)
                       (if (char=? (string-ref text (+ i 1)) delim)
                           (cons delim cur)
                           (cons (string-ref text (+ i 1)) (cons #\\ cur)))
                       parts))
                ((char=? (string-ref text i) delim) (loop (+ i 1) '() (cons (cur-str) parts)))
                (else (loop (+ i 1) (cons (string-ref text i) cur) parts))))))

    (define (bad-replacement . parts) (apply editor-error "E486: Bad replacement: " parts))

    ;; a Python re template as a list of strings and group numbers
    (define (parse-template t)
      (let ((n (string-length t)))
        (define (octal? c) (char<=? #\0 c #\7))
        (define (digit? c) (char<=? #\0 c #\9))
        (define (dval c) (- (char->integer c) 48))
        (let loop ((i 0) (acc '()))
          (cond
           ((>= i n) (reverse acc))
           ((not (char=? (string-ref t i) #\\)) (loop (+ i 1) (cons (string (string-ref t i)) acc)))
           ((= (+ i 1) n) (bad-replacement "bad escape (end of pattern)"))
           (else
            (let ((c (string-ref t (+ i 1))))
              (cond
               ((char=? c #\g)
                (let ((close (string-index-of t ">" (+ i 2))))
                  (unless (and (< (+ i 2) n) (char=? (string-ref t (+ i 2)) #\<) close)
                    (bad-replacement "missing group name"))
                  (let ((g (parse-int (substring t (+ i 3) close))))
                    (unless (and g (>= g 0)) (bad-replacement "bad group name " (substring t (+ i 3) close)))
                    (loop (+ close 1) (cons g acc)))))
               ((char=? c #\0)
                (let oct ((j (+ i 2)) (v 0))
                  (if (and (< j n) (< j (+ i 4)) (octal? (string-ref t j)))
                      (oct (+ j 1) (+ (* v 8) (dval (string-ref t j))))
                      (loop j (cons (string (integer->char v)) acc)))))
               ((digit? c)
                (if (and (< (+ i 3) n) (octal? c) (octal? (string-ref t (+ i 2))) (octal? (string-ref t (+ i 3))))
                    (loop (+ i 4) (cons (string (integer->char (+ (* 64 (dval c)) (* 8 (dval (string-ref t (+ i 2))))
                                                                  (dval (string-ref t (+ i 3))))))
                                        acc))
                    (if (and (< (+ i 2) n) (digit? (string-ref t (+ i 2))))
                        (loop (+ i 3) (cons (+ (* 10 (dval c)) (dval (string-ref t (+ i 2)))) acc))
                        (loop (+ i 2) (cons (dval c) acc)))))
               ((assv c '((#\a . "\x7;") (#\b . "\x8;") (#\f . "\xc;") (#\n . "\n") (#\r . "\r")
                          (#\t . "\t") (#\v . "\xb;") (#\\ . "\\")))
                => (lambda (p) (loop (+ i 2) (cons (cdr p) acc))))
               ((or (char<=? #\a c #\z) (char<=? #\A c #\Z))
                (bad-replacement "bad escape \\" (string c) " at position " (number->string i)))
               (else (loop (+ i 2) (cons (string #\\ c) acc))))))))))

    (define (expand-template parts line m)
      (apply string-append
             (map (lambda (p)
                    (cond ((string? p) p)
                          ((>= p (vector-length m)) (bad-replacement "invalid group reference " (number->string p)))
                          ((vector-ref m p) => (lambda (g) (substring line (car g) (cdr g))))
                          (else "")))
                  parts)))

    ;; Python's rx.subn(template, line, count): (values new-line count)
    (define (vim-substitute-line pattern parts line global)
      (let ((n (string-length line)) (out (open-output-string)))
        (let loop ((pos 0) (copied 0) (k 0))
          (let ((m (and (<= pos n) (or global (= k 0)) (regex-search line pattern pos))))
            (if (not m)
                (begin (write-string (substring line copied n) out)
                       (values (get-output-string out) k))
                (let ((s (car (vector-ref m 0))) (e (cdr (vector-ref m 0))))
                  (write-string (substring line copied s) out)
                  (write-string (expand-template parts line m) out)
                  (if (= s e)
                      (begin (when (< e n) (write-string (substring line e (+ e 1)) out))
                             (loop (+ e 1) (min n (+ e 1)) (+ k 1)))
                      (loop e e (+ k 1)))))))))

    (define (regex-escape s)
      (let ((out (open-output-string)))
        (string-for-each (lambda (c)
                           (when (string-index-of "\\.^$|?*+()[]{}" (string c)) (write-char #\\ out))
                           (write-char c out))
                         s)
        (get-output-string out)))

    ;; (regex-match s pattern): the groups of a match at the start as
    ;; strings (#f for unmatched groups) followed by the match end, or #f
    (define (regex-match s pattern)
      (let ((m (regex-search s pattern)))
        (and m (= (car (vector-ref m 0)) 0)
             (append (map (lambda (g) (and g (substring s (car g) (cdr g)))) (vector->list m))
                     (list (cdr (vector-ref m 0)))))))

    ;; ------------------------------------------------------------------
    ;; the key map state

    (define-record-type vim
      (%make-vim mode vstart last-visual ins-kind serial goal last-find search-forward paste-insert
                 count op op-count prefix prefix-count typed)
      vim?
      (mode mode mode-set!)                     ; normal insert visual visual-line
      (vstart vstart vstart-set!)               ; visual anchor
      (last-visual last-visual last-visual-set!) ; (row1 . row2) for '<,'>
      (ins-kind ins-kind ins-kind-set!)         ; undo kind of the current insert
      (serial serial serial-set!)
      (goal goal goal-set!)
      (last-find last-find last-find-set!)
      (search-forward search-forward search-forward-set!)
      (paste-insert paste-insert paste-insert-set!)
      (count count count-set!)                  ; typed digits
      (op op op-set!)
      (op-count op-count op-count-set!)
      (prefix prefix prefix-set!)
      (prefix-count prefix-count prefix-count-set!)
      (typed typed typed-set!))

    (define (reset! v)
      (count-set! v "")
      (op-set! v #f)
      (op-count-set! v #f)
      (prefix-set! v #f)
      (prefix-count-set! v #f)
      (typed-set! v ""))

    (define (visual? v) (memq (mode v) '(visual visual-line)))

    (define vertical-keys '(#\j #\k up down ctrl-n ctrl-p))
    (define motion-keys
      '(#\h #\l #\j #\k #\w #\W #\b #\B #\e #\E #\0 #\^ #\$ #\G #\n #\N #\; #\, #\space #\+ #\-
        left right up down home end backspace ctrl-h cr lf ctrl-n ctrl-p))
    (define operator-keys '(#\d #\c #\y #\> #\<))

    (define (selection v ed)
      (and (visual? v) (vstart v)
           (let* ((b (editor-cur ed))
                  (r (min (car (vstart v)) (buffer-last-row b)))
                  (anchor (cons r (min (cdr (vstart v)) (string-length (buffer-line b r))))))
             (let-values (((s e) (sort-pos anchor (buffer-pos b))))
               (if (eq? (mode v) 'visual-line)
                   (list (cons (car s) 0) (cons (car e) (string-length (buffer-line b (car e)))) #t)
                   (list s (cons (car e) (min (string-length (buffer-line b (car e))) (+ (cdr e) 1))) #f))))))

    (define (handle v ed key)
      (when (pair? key)
        ;; ESC followed quickly by a key arrives as one meta key
        (handle v ed 'esc)
        (set! key (cdr key)))
      (let ((keep-goal #f))
        (dynamic-wind
          (lambda () #f)
          (lambda ()
            (guard (e (#t (reset! v) (raise e)))
              (if (eq? (mode v) 'insert)
                  (insert-key v ed key)
                  (set! keep-goal (normal-key v ed key)))))
          (lambda ()
            (unless keep-goal (goal-set! v #f))
            (when (and (not (eq? (mode v) 'insert)) (editor-cur ed))
              (let ((b (editor-cur ed)))
                (buffer-col-set! b (min (buffer-col b) (max 0 (- (string-length (buffer-line b (buffer-row b))) 1))))))))))

    ;; ------------------------------------------------------------------
    ;; insert mode

    (define (new-insert-kind! v)
      (serial-set! v (+ (serial v) 1))
      (ins-kind-set! v (cons "vim-insert" (serial v)))
      (ins-kind v))

    ;; switch to insert mode; setup runs in the same undo step as the text
    ;; typed afterwards (e.g. the newline of 'o')
    (define (enter-insert! v ed . setup)
      (let ((kind (new-insert-kind! v)))
        (when (pair? setup) (editor-execute! ed (car setup) kind))
        (mode-set! v 'insert)))

    (define (leave-insert! v ed)
      (let* ((b (editor-cur ed))
             (line (buffer-line b (buffer-row b))))
        (when (and (> (string-length line) 0) (string=? (string-strip line) "") (ins-kind v))
          ;; like vim's autoindent: a line left with only indentation is
          ;; emptied (as part of the same undo step)
          (editor-execute! ed (lambda ()
                                (buffer-delete! b (cons (buffer-row b) 0) (cons (buffer-row b) (string-length line)))
                                (buffer-col-set! b 0))
                           (ins-kind v)))
        (mode-set! v 'normal)
        (ins-kind-set! v #f)
        (buffer-break-group! b)
        (when (> (buffer-col b) 0) (buffer-col-set! b (- (buffer-col b) 1)))))

    (define insert-edit
      '((cr . "newline") (lf . "newline") (tab . "tab") (backspace . "delete_backward_char")
        (ctrl-h . "delete_backward_char") (delete . "delete_char")))
    (define insert-move
      '((left . "backward_char") (right . "forward_char") (up . "previous_line") (down . "next_line")
        (home . "beginning_of_line") (end . "end_of_line") (page-up . "scroll_down")
        (page-down . "scroll_up")))

    (define (insert-key v ed key)
      (cond ((memq key '(esc ctrl-c))
             (paste-insert-set! v #f)
             (leave-insert! v ed))
            ((assv key insert-edit) => (lambda (p) (editor-call! ed (cdr p) key (ins-kind v))))
            ((assv key insert-move) => (lambda (p) (editor-call! ed (cdr p) key #f)))
            ((eq? key 'ctrl-w)
             (editor-execute! ed (lambda ()
                                   (let* ((b (editor-cur ed))
                                          (start (buffer-word-backward b (buffer-row b) (buffer-col b))))
                                     (buffer-delete! b start (buffer-pos b))
                                     (buffer-goto! b start)))
                              (ins-kind v)))
            ((printable-key? key) (editor-call! ed "self_insert" key (ins-kind v)))))

    ;; ------------------------------------------------------------------
    ;; normal / visual mode

    (define (digit-key? key) (and (char? key) (char<=? #\0 key #\9)))
    (define (add-typed! v key) (typed-set! v (string-append (typed v) (string key))))

    ;; handle one key; returns #t when the goal column must be kept
    (define (normal-key v ed key)
      (let ((b (editor-cur ed)) (vis (visual? v)))
        (cond
         ((memv (prefix v) '(#\r #\f #\t #\F #\T))
          (let ((p (prefix v)) (cnt (prefix-count v)))
            (prefix-set! v #f)
            (cond ((not (printable-key? key)) (reset! v) #f)
                  ((char=? p #\r)
                   (reset! v)
                   (editor-execute! ed (lambda () (replace-char ed key (or cnt 1))))
                   #f)
                  (else
                   (last-find-set! v (cons p key))
                   (do-motion v ed (list 'find p key) cnt)))))
         ((eqv? (prefix v) #\g)
          (let ((cnt (prefix-count v)))
            (prefix-set! v #f)
            (if (eqv? key #\g)
                (do-motion v ed 'gg cnt)
                (begin (reset! v)
                       (editor-error "g" (describe-key key) " is not supported")))))
         ((eqv? (prefix v) #\Z)
          (reset! v)
          (cond ((eqv? key #\Z) (ex v ed "x"))
                ((eqv? key #\Q) (ex v ed "q!")))
          #f)
         ((memq key '(esc ctrl-c))
          (when vis
            (mode-set! v 'normal)
            (vstart-set! v #f))
          (reset! v)
          #f)
         ((and (digit-key? key) (or (not (eqv? key #\0)) (not (string=? (count v) ""))))
          (count-set! v (string-append (count v) (string key)))
          (add-typed! v key)
          #f)
         (else
          (let ((cnt (if (string=? (count v) "") #f (string->number (count v)))))
            (count-set! v "")
            (cond
             ((memv key '(#\g #\Z #\r #\f #\t #\F #\T))
              (if (and (memv key '(#\Z #\r)) (or (op v) vis))
                  (reset! v)
                  (begin (prefix-set! v key)
                         (prefix-count-set! v cnt)
                         (add-typed! v key)))
              #f)
             ((and (not vis) (memv key operator-keys) (not (op v)))
              (op-set! v key)
              (op-count-set! v cnt)
              (add-typed! v key)
              #f)
             ((and (not vis) (memv key operator-keys) (eqv? (op v) key))   ; dd, cc, yy, >>, <<
              (let ((n (* (or (op-count v) 1) (or cnt 1)))
                    (o (op v)))
                (reset! v)
                (run-op v ed o (cons (buffer-row b) 0)
                        (cons (min (buffer-last-row b) (+ (buffer-row b) n -1)) 0) 'line)
                #f))
             ((member key motion-keys) (do-motion v ed key cnt))
             ((op v) (reset! v) #f)
             (else
              (typed-set! v "")
              (if vis (visual-cmd v ed key cnt) (command v ed key cnt))
              #f)))))))

    (define (do-motion v ed motion cnt)
      (let* ((o (op v))
             (cnt (if (and o (or (op-count v) cnt)) (* (or (op-count v) 1) (or cnt 1)) cnt)))
        (reset! v)
        (let* ((b (editor-cur ed))
               (start (buffer-pos b)))
          (let-values (((target mtype) (motion-target v ed motion cnt o)))
            (if o
                (begin (run-op v ed o start target mtype) #f)
                (begin (buffer-goto! b target)
                       (and (or (member motion vertical-keys) (memv motion '(#\$ end))) #t)))))))

    ;; (values target-position motion-type); types: excl incl line
    (define (motion-target v ed m cnt o)
      (let* ((b (editor-cur ed))
             (r (buffer-row b)) (c (buffer-col b))
             (n (or cnt 1))
             (last (buffer-last-row b))
             (line (buffer-line b r)))
        (define (repeat f pos k) (if (<= k 0) pos (repeat f (f pos) (- k 1))))
        (cond
         ((pair? m) (find-char b (cadr m) (caddr m) n))
         ((memv m '(#\h left backspace ctrl-h)) (values (cons r (max 0 (- c n))) 'excl))
         ((memv m '(#\l right #\space))
          (let ((limit (if o (string-length line) (max 0 (- (string-length line) 1)))))
            (values (cons r (min limit (+ c n))) 'excl)))
         ((memv m vertical-keys)
          (let ((nr (max 0 (min last (if (memv m '(#\j down ctrl-n)) (+ r n) (- r n))))))
            (unless (goal v) (goal-set! v c))
            (values (cons nr (min (goal v) (string-length (buffer-line b nr)))) 'line)))
         ((memv m '(#\+ cr lf #\-))
          (let ((nr (max 0 (min last (if (eqv? m #\-) (- r n) (+ r n))))))
            (values (cons nr (first-nonblank (buffer-line b nr))) 'line)))
         ((memv m '(#\0 home)) (values (cons r 0) 'excl))
         ((eqv? m #\^) (values (cons r (first-nonblank line)) 'excl))
         ((memv m '(#\$ end))
          (let* ((nr (min last (+ r n -1)))
                 (l (buffer-line b nr)))
            (goal-set! v (expt 2 30))
            (values (cons nr (max 0 (- (string-length l) 1))) (if (string=? l "") 'excl 'incl))))
         ((memv m '(#\w #\W))
          (let ((big (eqv? m #\W)))
            (if (and (eqv? o #\c) (not (eq? (char-class (buffer-char-at b r c) big) 'space)))
                ;; cw changes to the end of the word, like ce
                (let* ((cls (char-class (buffer-char-at b r c) big))
                       (col (let loop ((col c))
                              (if (and (< (+ col 1) (string-length line))
                                       (eq? (char-class (string-ref line (+ col 1)) big) cls))
                                  (loop (+ col 1))
                                  col))))
                  (values (repeat (lambda (p) (vim-word-end b (car p) (cdr p) big)) (cons r col) (- n 1))
                          'incl))
                (let loop ((k 0) (pos (cons r c)) (prev (cons r c)))
                  (if (< k n)
                      (loop (+ k 1) (vim-word-forward b (car pos) (cdr pos) big) pos)
                      (values (if (and o (> (car pos) (car prev)))
                                  ;; the last word moved over ends its line: stop there
                                  (cons (car prev) (string-length (buffer-line b (car prev))))
                                  pos)
                              'excl))))))
         ((memv m '(#\e #\E))
          (values (repeat (lambda (p) (vim-word-end b (car p) (cdr p) (eqv? m #\E))) (cons r c) n) 'incl))
         ((memv m '(#\b #\B))
          (values (repeat (lambda (p) (vim-word-back b (car p) (cdr p) (eqv? m #\B))) (cons r c) n) 'excl))
         ((memv m '(#\G gg))
          (let ((nr (if cnt (min last (- cnt 1)) (if (eqv? m #\G) last 0))))
            (values (cons nr (first-nonblank (buffer-line b nr))) 'line)))
         ((memv m '(#\n #\N))
          (let ((forward (if (eqv? m #\n) (search-forward v) (not (search-forward v)))))
            (values (repeat (lambda (p) (vim-search ed (editor-last-search ed) forward p)) (cons r c) n)
                    'excl)))
         ((memv m '(#\; #\,))
          (unless (last-find v) (editor-error "No previous f/t/F/T"))
          (let* ((p (car (last-find v)))
                 (p (if (eqv? m #\,) (if (char-upper-case? p) (char-downcase p) (char-upcase p)) p)))
            (find-char b p (cdr (last-find v)) n)))
         (else (editor-error (describe-key m) " is not a motion")))))

    ;; f/t/F/T: (values position motion-type)
    (define (find-char b p ch n)
      (let* ((r (buffer-row b)) (c (buffer-col b))
             (line (buffer-line b r))
             (s (string ch))
             (idx (let loop ((k 0) (idx c))
                    (if (= k n)
                        idx
                        (let ((found
                               (if (memv p '(#\f #\t))
                                   (string-find line s (+ idx (if (and (char=? p #\t) (= idx c) (< (+ c 1) (string-length line))
                                                                       (char=? (string-ref line (+ c 1)) ch))
                                                                  2 1)))
                                   (string-rfind line s 0 (- idx (if (and (char=? p #\T) (= idx c) (> c 0)
                                                                         (char=? (string-ref line (- c 1)) ch))
                                                                    1 0))))))
                          (when (< found 0) (editor-error (string ch) " not found"))
                          (loop (+ k 1) found))))))
        (case p
          ((#\f) (values (cons r idx) 'incl))
          ((#\t) (values (cons r (- idx 1)) 'incl))
          ((#\F) (values (cons r idx) 'excl))
          (else (values (cons r (+ idx 1)) 'excl)))))

    (define (vim-search ed query forward . pos)
      (when (string=? query "") (editor-error "E35: No previous regular expression"))
      (let* ((b (editor-cur ed))
             (p (if (pair? pos) (car pos) (buffer-pos b)))
             (r (car p)) (c (cdr p))
             (found (if forward
                        (buffer-search b query r (+ c 1) #t)
                        (buffer-search b query r (+ c (string-length query) -1) #f))))
        (unless found (editor-error "E486: Pattern not found: " query))
        (cond ((and forward (pos<=? found p))
               (editor-message-set! ed "search hit BOTTOM, continuing at TOP"))
              ((and (not forward) (pos<=? p found))
               (editor-message-set! ed "search hit TOP, continuing at BOTTOM")))
        found))

    ;; ------------------------------------------------------------------
    ;; operators

    (define (set-register! ed text linewise)
      (editor-kill-text-set! ed text)
      (editor-kill-linewise-set! ed linewise))

    (define (run-op v ed o start end mtype)
      (let ((kind (and (eqv? o #\c) (new-insert-kind! v))))
        (editor-execute! ed (lambda () (apply-op ed o start end mtype)) kind)
        (when (eqv? o #\c) (mode-set! v 'insert))))

    (define (line-slice b r1 r2)
      (let loop ((r r2) (acc '()))
        (if (< r r1) acc (loop (- r 1) (cons (buffer-line b r) acc)))))

    (define (apply-op ed o start end mtype)
      (let ((b (editor-cur ed)))
        (if (eq? mtype 'line)
            (let* ((r1 (min (car start) (car end)))
                   (r2 (max (car start) (car end)))
                   (text (string-append (string-join* (line-slice b r1 r2) "\n") "\n")))
              (case o
                ((#\y)
                 (set-register! ed text #t)
                 (when (< r1 (buffer-row b)) (buffer-row-set! b r1))
                 (let ((n (+ (- r2 r1) 1)))
                   (when (> n 2) (editor-message-set! ed (string-append (number->string n) " lines yanked")))))
                ((#\d)
                 (set-register! ed text #t)
                 (delete-lines! b r1 r2)
                 (buffer-row-set! b (min r1 (buffer-last-row b)))
                 (buffer-col-set! b (first-nonblank (buffer-line b (buffer-row b)))))
                ((#\c)
                 (set-register! ed text #t)
                 (let ((indent (first-nonblank (buffer-line b r1))))
                   (buffer-delete! b (cons r1 indent) (cons r2 (string-length (buffer-line b r2))))
                   (buffer-goto! b (cons r1 indent))))
                (else (shift! b r1 r2 (eqv? o #\>)))))
            (let-values (((s e) (sort-pos start end)))
              (let ((e (if (eq? mtype 'incl)
                           (cons (car e) (min (string-length (buffer-line b (car e))) (+ (cdr e) 1)))
                           e)))
                (if (memv o '(#\> #\<))
                    (shift! b (car s) (car e) (eqv? o #\>))
                    (begin
                      (set-register! ed (buffer-text-range b s e) #f)
                      (when (memv o '(#\d #\c)) (buffer-delete! b s e))
                      (buffer-goto! b s))))))))

    (define (delete-lines! b r1 r2)
      (cond ((< r2 (buffer-last-row b)) (buffer-delete! b (cons r1 0) (cons (+ r2 1) 0)))
            ((> r1 0) (buffer-delete! b (cons (- r1 1) (string-length (buffer-line b (- r1 1))))
                                      (cons r2 (string-length (buffer-line b r2)))))
            (else (buffer-delete! b (cons 0 0) (cons r2 (string-length (buffer-line b r2)))))))

    (define (shift! b r1 r2 right)
      (let ((unit (if (buffer-uses-tabs b) "\t" (make-string indent-width #\space))))
        (do ((r r1 (+ r 1))) ((> r r2))
          (let ((line (buffer-line b r)))
            (cond (right (unless (string=? line "") (buffer-insert! b r 0 unit)))
                  ((string-starts? line "\t") (buffer-delete! b (cons r 0) (cons r 1)))
                  (else
                   (let ((n (- (string-length line) (string-length (string-lstrip line " ")))))
                     (when (> n 0) (buffer-delete! b (cons r 0) (cons r (min n indent-width)))))))))
        (buffer-row-set! b r1)
        (buffer-col-set! b (first-nonblank (buffer-line b r1)))))

    ;; ------------------------------------------------------------------
    ;; simple commands

    (define (replace-char ed ch n)
      (let* ((b (editor-cur ed)) (r (buffer-row b)) (c (buffer-col b)))
        (when (<= (+ c n) (string-length (buffer-line b r)))
          (buffer-delete! b (cons r c) (cons r (+ c n)))
          (buffer-insert! b r c (make-string n ch))
          (buffer-col-set! b (+ c n -1)))))

    (define (delete-chars ed n forward)
      (let* ((b (editor-cur ed)) (r (buffer-row b)) (c (buffer-col b)))
        (if forward
            (let ((e (min (string-length (buffer-line b r)) (+ c n))))
              (unless (= e c)
                (set-register! ed (buffer-delete! b (cons r c) (cons r e)) #f)))
            (let ((s (max 0 (- c n))))
              (unless (= s c)
                (set-register! ed (buffer-delete! b (cons r s) (cons r c)) #f)
                (buffer-col-set! b s))))))

    (define (paste ed after n)
      (let ((b (editor-cur ed)) (text (editor-kill-text ed)))
        (when (string=? text "") (editor-error "E353: Nothing in register"))
        (if (editor-kill-linewise ed)
            (let* ((block (string-repeat (if (string-ends? text "\n") text (string-append text "\n")) n))
                   (row (if after (+ (buffer-row b) 1) (buffer-row b))))
              (cond ((and after (>= row (buffer-line-count b)))
                     (buffer-insert! b (- row 1) (string-length (buffer-line b (- row 1)))
                                     (string-append "\n" (substring block 0 (- (string-length block) 1)))))
                    (else (buffer-insert! b row 0 block)))
              (buffer-row-set! b row)
              (buffer-col-set! b (first-nonblank (buffer-line b row))))
            (let* ((block (string-repeat text n))
                   (line (buffer-line b (buffer-row b)))
                   (col (if (and after (not (string=? line "")))
                            (min (string-length line) (+ (buffer-col b) 1))
                            (buffer-col b)))
                   (end (buffer-insert! b (buffer-row b) col block)))
              (if (string-contains? block "\n")
                  (buffer-col-set! b col)
                  (buffer-goto! b (cons (car end) (max 0 (- (cdr end) 1)))))))))

    (define (join-lines! b r1 cnt)
      (let loop ((k (max 1 (- cnt 1))))
        (when (and (> k 0) (< r1 (buffer-last-row b)))
          (let* ((cur (buffer-line b r1))
                 (nxt (buffer-line b (+ r1 1)))
                 (rest (string-lstrip nxt " \t")))
            (buffer-delete! b (cons r1 (string-length cur)) (cons (+ r1 1) (first-nonblank nxt)))
            (buffer-insert! b r1 (string-length cur)
                            (if (or (string=? cur "") (string-ends? cur " ") (string-ends? cur "\t")
                                    (string=? rest "") (string-starts? rest ")"))
                                ""
                                " "))
            (buffer-goto! b (cons r1 (string-length cur)))
            (loop (- k 1))))))

    (define (swapcase s)
      (string-map (lambda (c) (cond ((char-upper-case? c) (char-downcase c))
                                    ((char-lower-case? c) (char-upcase c))
                                    (else c)))
                  s))

    (define (change-case! b start end how)
      (let* ((text (buffer-text-range b start end))
             (new (case how ((toggle) (swapcase text)) ((lower) (string-downcase text)) (else (string-upcase text)))))
        (unless (string=? new text)
          (buffer-delete! b start end)
          (buffer-insert! b (car start) (cdr start) new))))

    (define (open-line! ed below)
      (let* ((b (editor-cur ed))
             (line (buffer-line b (buffer-row b)))
             (indent (substring line 0 (first-nonblank line))))
        (if below
            (buffer-goto! b (buffer-insert! b (buffer-row b) (string-length line) (string-append "\n" indent)))
            (begin (buffer-insert! b (buffer-row b) 0 (string-append indent "\n"))
                   (buffer-col-set! b (string-length indent))))))

    ;; (values word start-position) of the word under or after the cursor
    (define (word-under-cursor b)
      (let* ((line (buffer-line b (buffer-row b)))
             (n (string-length line))
             (c (let loop ((c (buffer-col b)))
                  (if (and (< c n) (not (word-char? (string-ref line c)))) (loop (+ c 1)) c))))
        (when (>= c n) (editor-error "E348: No string under cursor"))
        (let ((s (let loop ((s c)) (if (and (> s 0) (word-char? (string-ref line (- s 1)))) (loop (- s 1)) s)))
              (e (let loop ((e c)) (if (and (< e n) (word-char? (string-ref line e))) (loop (+ e 1)) e))))
          (values (substring line s e) (cons (buffer-row b) s)))))

    (define (command v ed key cnt)
      (let ((b (editor-cur ed)) (n (or cnt 1)))
        (define (undo-n proc msg)
          (let loop ((i 0))
            (when (< i n)
              (if (proc b)
                  (loop (+ i 1))
                  (when (= i 0) (editor-error msg))))))
        (cond
         ((eqv? key #\i) (enter-insert! v ed))
         ((eqv? key #\a)
          (enter-insert! v ed (lambda ()
                                (unless (string=? (buffer-line b (buffer-row b)) "")
                                  (buffer-col-set! b (+ (buffer-col b) 1))))))
         ((eqv? key #\I)
          (enter-insert! v ed (lambda () (buffer-col-set! b (first-nonblank (buffer-line b (buffer-row b)))))))
         ((eqv? key #\A)
          (enter-insert! v ed (lambda () (buffer-col-set! b (string-length (buffer-line b (buffer-row b)))))))
         ((memv key '(#\o #\O)) (enter-insert! v ed (lambda () (open-line! ed (eqv? key #\o)))))
         ((memv key '(#\x delete)) (editor-execute! ed (lambda () (delete-chars ed n #t))))
         ((eqv? key #\X) (editor-execute! ed (lambda () (delete-chars ed n #f))))
         ((memv key '(#\D #\C))
          (op-set! v (char-downcase key))
          (do-motion v ed #\$ cnt))
         ((eqv? key #\s)
          (op-set! v #\c)
          (do-motion v ed #\l cnt))
         ((memv key '(#\S #\Y))
          (run-op v ed (if (eqv? key #\S) #\c #\y) (cons (buffer-row b) 0)
                  (cons (min (buffer-last-row b) (+ (buffer-row b) n -1)) 0) 'line))
         ((memv key '(#\p #\P)) (editor-execute! ed (lambda () (paste ed (eqv? key #\p) n))))
         ((eqv? key #\J) (editor-execute! ed (lambda () (join-lines! b (buffer-row b) (max 2 n)))))
         ((eqv? key #\~)
          (editor-execute! ed (lambda ()
                                (let ((e (min (string-length (buffer-line b (buffer-row b))) (+ (buffer-col b) n))))
                                  (change-case! b (buffer-pos b) (cons (buffer-row b) e) 'toggle)
                                  (buffer-col-set! b e)))))
         ((eqv? key #\u) (undo-n buffer-undo! "Already at oldest change"))
         ((eq? key 'ctrl-r) (undo-n buffer-redo! "Already at newest change"))
         ((memv key '(#\v #\V))
          (mode-set! v (if (eqv? key #\v) 'visual 'visual-line))
          (vstart-set! v (buffer-pos b)))
         ((eqv? key #\:) (ex-prompt v ed ""))
         ((memv key '(#\/ #\?))
          (let ((query (let ((q (editor-prompt ed (string key)))) (if (string=? q "") (editor-last-search ed) q))))
            (search-forward-set! v (eqv? key #\/))
            (editor-last-search-set! ed query)
            (buffer-goto! b (vim-search ed query (search-forward v)))))
         ((memv key '(#\* #\#))
          (let-values (((word pos) (word-under-cursor b)))
            (editor-last-search-set! ed word)
            (search-forward-set! v (eqv? key #\*))
            (buffer-goto! b (vim-search ed word (search-forward v) pos))))
         ((memq key '(ctrl-f page-down)) (editor-call! ed "scroll_up"))
         ((memq key '(ctrl-b page-up)) (editor-call! ed "scroll_down"))
         ((memq key '(ctrl-d ctrl-u))
          (let ((half (max 1 (quotient (editor-text-rows ed) 2))))
            (if (eq? key 'ctrl-d)
                (begin (buffer-row-set! b (min (buffer-last-row b) (+ (buffer-row b) half)))
                       (buffer-top-set! b (min (max 0 (buffer-last-row b)) (+ (buffer-top b) half))))
                (begin (buffer-row-set! b (max 0 (- (buffer-row b) half)))
                       (buffer-top-set! b (max 0 (- (buffer-top b) half)))))))
         ((eq? key 'ctrl-g)
          (editor-message-set!
           ed (string-append "\"" (buffer-name b) "\"" (if (buffer-modified? b) " [Modified]" "")
                             " " (number->string (buffer-line-count b)) " lines --"
                             (number->string (quotient (* 100 (+ (buffer-row b) 1)) (buffer-line-count b))) "%--")))
         ((eq? key 'ctrl-l) #f)
         (else (editor-error (describe-key key) " is not supported in vim mode")))))

    (define visual-ops '((#\d . #\d) (#\x . #\d) (delete . #\d) (#\y . #\y) (#\c . #\c) (#\s . #\c)
                         (#\> . #\>) (#\< . #\<)))
    (define visual-line-ops '((#\D . #\d) (#\X . #\d) (#\Y . #\y) (#\C . #\c) (#\S . #\c) (#\R . #\c)))

    (define (visual-cmd v ed key cnt)
      (let* ((b (editor-cur ed))
             (sel (selection v ed))
             (s (car sel)) (e (cadr sel)) (linewise (caddr sel)))
        (cond
         ((memv key '(#\v #\V))
          (let ((want (if (eqv? key #\v) 'visual 'visual-line)))
            (if (eq? (mode v) want)
                (begin (mode-set! v 'normal) (vstart-set! v #f))
                (mode-set! v want))))
         ((eqv? key #\o)
          (let ((anchor (vstart v)))
            (vstart-set! v (buffer-pos b))
            (buffer-goto! b anchor)))
         ((eqv? key #\:)
          (last-visual-set! v (cons (car s) (car e)))
          (mode-set! v 'normal)
          (vstart-set! v #f)
          (ex-prompt v ed "'<,'>"))
         (else
          (mode-set! v 'normal)
          (vstart-set! v #f)
          (cond
           ((or (assv key visual-ops) (assv key visual-line-ops))
            (let ((o (cdr (or (assv key visual-ops) (assv key visual-line-ops)))))
              (if (or linewise (assv key visual-line-ops) (memv o '(#\> #\<)))
                  (run-op v ed o (cons (car s) 0) (cons (car e) 0) 'line)
                  (run-op v ed o s e 'excl))))
           ((memv key '(#\~ #\u #\U))
            (let ((how (case key ((#\~) 'toggle) ((#\u) 'lower) (else 'upper)))
                  (s (if linewise (cons (car s) 0) s))
                  (e (if linewise (cons (car e) (string-length (buffer-line b (car e)))) e)))
              (editor-execute! ed (lambda ()
                                    (change-case! b s e how)
                                    (buffer-goto! b s)))))
           ((eqv? key #\J)
            (editor-execute! ed (lambda () (join-lines! b (car s) (max 2 (+ (- (car e) (car s)) 1))))))
           (else (editor-error (describe-key key) " is not supported in visual mode")))))))

    ;; ------------------------------------------------------------------
    ;; ex commands

    (define (ex-complete ed text)
      (cond ((regex-match text "^(e|edit|w|write|sav|saveas)(!?\\s+)(.*)$")
             => (lambda (m)
                  (map (lambda (p) (string-append (list-ref m 1) (list-ref m 2) p))
                       (editor-complete-file ed (list-ref m 3)))))
            ((regex-match text "^(b|buffer)(\\s+)(.*)$")
             => (lambda (m)
                  (map (lambda (n) (string-append (list-ref m 1) (list-ref m 2) n))
                       (editor-complete-buffer ed (list-ref m 3)))))
            (else '())))

    (define (ex-prompt v ed default)
      (ex v ed (editor-prompt ed ":" default (lambda (t) (ex-complete ed t)))))

    ;; (values (row1 . row2) or #f, rest of the command)
    (define (parse-range v ed text)
      (let* ((b (editor-cur ed))
             (last (buffer-last-row b))
             (addr "(?:\\d+|[.$]|'[<>])")
             (m (regex-match text (string-append "^\\s*(%|" addr ")(?:\\s*,\\s*(" addr "))?"))))
        (define (value a)
          (cond ((string=? a ".") (buffer-row b))
                ((string=? a "$") last)
                ((member a '("'<" "'>"))
                 (unless (last-visual v) (editor-error "E20: Mark not set"))
                 (if (string=? a "'<") (car (last-visual v)) (cdr (last-visual v))))
                (else (max 0 (min last (- (string->number a) 1))))))
        (if (not m)
            (values #f (string-strip text))
            (let ((rest (string-strip (substring text (list-ref m 3) (string-length text)))))
              (if (string=? (list-ref m 1) "%")
                  (values (cons 0 last) rest)
                  (let* ((r1 (value (list-ref m 1)))
                         (r2 (if (list-ref m 2) (value (list-ref m 2)) r1)))
                    (values (cons (min r1 r2) (max r1 r2)) rest)))))))

    (define (ex v ed text)
      (let-values (((rng rest) (parse-range v ed text)))
        (let ((b (editor-cur ed)))
          (cond
           ((string=? rest "")
            (when rng                                    ; :42 goes to line 42
              (buffer-row-set! b (cdr rng))
              (buffer-col-set! b (first-nonblank (buffer-line b (buffer-row b))))))
           ;; :s/a/b/ - the delimiter directly follows the command name
           ((regex-match rest "^(s|substitute)([^A-Za-z0-9\\s\\\\\"|])(.*)$")
            => (lambda (m)
                 (substitute! v ed (or rng (cons (buffer-row b) (buffer-row b)))
                              (string-ref (list-ref m 2) 0) (list-ref m 3))))
           ((regex-match rest "^([A-Za-z]+)(!?)\\s*(.*)$")
            => (lambda (m) (ex-command v ed b rest (list-ref m 1) (string=? (list-ref m 2) "!") (list-ref m 3))))
           (else (editor-error "E492: Not an editor command: " rest))))))

    (define (save-modified! ed)
      (for-each (lambda (buf) (when (buffer-modified? buf) (editor-save-buffer! ed buf)))
                (editor-buffers ed)))

    (define (ex-command v ed b rest name bang arg)
      (define (is? . names) (member name names))
      (cond
       ((is? "w" "write" "wq" "x" "xit" "exit")
        (cond ((and (is? "x" "xit" "exit") (not (buffer-modified? b)) (buffer-path b) (string=? arg "")) #f)
              ((not (string=? arg ""))
               (let ((path (editor-resolve ed arg)))
                 (cond ((not (buffer-path b))
                        (buffer-path-set! b path)
                        (buffer-name-set! b (editor-unique-name ed (path-basename path) b))
                        (editor-save-buffer! ed b))
                       ((string=? (path-normcase path) (path-normcase (buffer-path b)))
                        (editor-save-buffer! ed b))
                       (else
                        (when (and (path-exists?* path) (not bang))
                          (editor-error "E13: File exists (add ! to override)"))
                        (buffer-write-copy b path)
                        (editor-message-set! ed (string-append "\"" arg "\" written"))))))
              (else (editor-save-buffer! ed b)))
        (unless (is? "w" "write") (quit! ed bang)))
       ((is? "wa" "wall") (save-modified! ed))
       ((is? "q" "quit" "qa" "qall" "quitall") (quit! ed bang))
       ((is? "wqa" "wqall" "xa" "xall") (save-modified! ed) (quit! ed bang))
       ((is? "e" "edit")
        (cond ((not (string=? arg "")) (editor-open-file! ed arg))
              ((not (buffer-path b)) (editor-error "E32: No file name"))
              ((and (buffer-modified? b) (not bang))
               (editor-error "E37: No write since last change (add ! to override)"))
              (else (reload! ed b))))
       ((is? "bn" "bnext" "bp" "bprevious" "bN" "bNext")
        (let* ((bufs (editor-buffers ed))
               (idx (list-index-of (lambda (x) (eq? x b)) bufs))
               (step (if (is? "bn" "bnext") 1 -1)))
          (editor-select! ed (list-ref bufs (modulo (+ idx step) (length bufs))))))
       ((is? "b" "buffer") (switch-buffer! ed arg))
       ((is? "ls" "buffers" "files")
        (editor-message-set!
         ed (string-join*
             (let loop ((bs (editor-buffers ed)) (i 1) (acc '()))
               (if (null? bs)
                   (reverse acc)
                   (let ((x (car bs)))
                     (loop (cdr bs) (+ i 1)
                           (cons (string-append (number->string i) (if (eq? x b) "%" " ")
                                                (if (buffer-modified? x) "+" "") " " (buffer-name x))
                                 acc)))))
             "  ")))
       ((is? "bd" "bdelete")
        (when (and (buffer-modified? b) (not bang))
          (editor-error "E89: No write since last change (add ! to override)"))
        (editor-buffers-set! ed (filter (lambda (x) (not (eq? x b))) (editor-buffers ed)))
        (when (null? (editor-buffers ed)) (editor-new-buffer! ed "[No Name]"))
        (editor-cur-set! ed (if (memq (editor-prev ed) (editor-buffers ed))
                                (editor-prev ed)
                                (car (reverse (editor-buffers ed)))))
        (editor-prev-set! ed #f))
       ((is? "emacs") (editor-set-keymap! ed "emacs"))
       ((is? "noh" "nohlsearch") #f)
       ((is? "h" "help")
        (editor-message-set! ed "i insert, Esc normal, :w save, :q quit, :wq save+quit, :q! discard"))
       (else (editor-error "E492: Not an editor command: " rest))))

    (define (quit! ed force)
      (unless force
        (for-each (lambda (buf)
                    (when (buffer-modified? buf)
                      (if (eq? buf (editor-cur ed))
                          (editor-error "E37: No write since last change (add ! to override)")
                          (editor-error "E162: No write since last change for buffer \"" (buffer-name buf) "\""))))
                  (editor-buffers ed)))
      (editor-running-set! ed #f))

    (define (reload! ed b)
      (let ((fresh (buffer-from-file (buffer-path b) (buffer-name b))))
        (buffer-row-set! fresh (min (buffer-row b) (buffer-last-row fresh)))
        (editor-buffers-set! ed (map (lambda (x) (if (eq? x b) fresh x)) (editor-buffers ed)))
        (when (eq? (editor-prev ed) b) (editor-prev-set! ed #f))
        (editor-cur-set! ed fresh)))

    (define (switch-buffer! ed arg)
      (let ((arg (string-strip arg))
            (bufs (editor-buffers ed)))
        (unless (string=? arg "")
          (if (and (> (string-length arg) 0) (string-every* char-numeric? arg))
              (let ((idx (- (string->number arg) 1)))
                (unless (and (>= idx 0) (< idx (length bufs)))
                  (editor-error "E86: Buffer " arg " does not exist"))
                (editor-select! ed (list-ref bufs idx)))
              (let ((matches (let ((exact (filter (lambda (x) (string=? (buffer-name x) arg)) bufs)))
                               (if (pair? exact)
                                   exact
                                   (filter (lambda (x) (string-contains? (buffer-name x) arg)) bufs)))))
                (unless (= (length matches) 1)
                  (if (pair? matches)
                      (editor-error "E93: More than one match for " arg)
                      (editor-error "E94: No matching buffer for " arg)))
                (editor-select! ed (car matches)))))))

    (define (string-every* pred s)
      (let loop ((i 0)) (or (= i (string-length s)) (and (pred (string-ref s i)) (loop (+ i 1))))))

    (define (substitute! v ed rng delim body)
      (let* ((parts (split-unescaped body delim))
             (pattern (if (string=? (car parts) "") (regex-escape (editor-last-search ed)) (car parts)))
             (repl (if (pair? (cdr parts)) (vim-replacement (cadr parts)) ""))
             (flags (if (and (pair? (cdr parts)) (pair? (cddr parts))) (caddr parts) ""))
             (pattern (if (string-contains? flags "i") (string-append "(?i)" pattern) pattern))
             (global (string-contains? flags "g"))
             (b (editor-cur ed))
             (total 0) (changed-lines 0) (last-row #f))
        (guard (e ((not (editor-error? e)) (editor-error "E486: Bad pattern: " (report-error e))))
          (regex-search "" pattern))
        (editor-execute!
         ed
         (lambda ()
           (let ((template (parse-template repl)))
             (do ((r (car rng) (+ r 1))) ((> r (cdr rng)))
               (let ((line (buffer-line b r)))
                 (let-values (((new k) (vim-substitute-line pattern template line global)))
                   (when (and (> k 0) (not (string=? new line)))
                     (buffer-delete! b (cons r 0) (cons r (string-length line)))
                     (buffer-insert! b r 0 new))
                   (when (> k 0)
                     (set! total (+ total k))
                     (set! changed-lines (+ changed-lines 1))
                     (set! last-row r))))))))
        (when (= total 0) (editor-error "E486: Pattern not found: " (car parts)))
        (buffer-row-set! b last-row)
        (buffer-col-set! b (first-nonblank (buffer-line b last-row)))
        (when (> total 1)
          (editor-message-set! ed (string-append (number->string total) " substitutions on "
                                                 (number->string changed-lines) " line"
                                                 (if (= changed-lines 1) "" "s"))))))

    ;; ------------------------------------------------------------------
    ;; the key map

    (define (make-vim-keymap)
      (let ((v (%make-vim 'normal #f #f #f 0 #f #f #t #f "" #f #f #f #f "")))
        (make-keymap "vim"
                     (lambda (ed key) (handle v ed key))
                     (lambda () (if (string=? (typed v) "") #f (typed v)))
                     (lambda (ed) (case (mode v)
                                    ((insert) "-- INSERT --")
                                    ((visual) "-- VISUAL --")
                                    ((visual-line) "-- VISUAL LINE --")
                                    (else "")))
                     (lambda (ed) (selection v ed))
                     ;; bar in insert mode, block otherwise
                     (lambda () (if (eq? (mode v) 'insert) "\x1b;[6 q" "\x1b;[2 q"))
                     (lambda (ed)
                       (when (eq? (mode v) 'normal)
                         (paste-insert-set! v #t)
                         (enter-insert! v ed)))
                     (lambda (ed)
                       (when (and (paste-insert v) (eq? (mode v) 'insert))
                         (paste-insert-set! v #f)
                         (leave-insert! v ed))))))

    (register-keymap! "vim" make-vim-keymap)))
