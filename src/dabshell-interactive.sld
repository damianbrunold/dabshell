;; dabshell interactive: the prompt, the line editor with history, reverse
;; search and completion, the history file and the main loop.

(define-library (dabshell interactive)
  (export prompt-string load-history! run-interactive run-lines
          install-interrupt-handler! start-shell
          make-editor ed-line ed-index handle-key! search-key ed-search?)
  (import (scheme base)
          (scheme char)
          (scheme file)
          (scheme process-context)
          (srfi 69)
          (only (srfi 1) filter delete-duplicates)
          (scm fs)
          (scm system)
          (scm terminal)
          (scm toml)
          (dabshell util)
          (dabshell core)
          (dabshell keys)
          (dabshell completion))
  (begin

    (define esc "\x1b;")

    ;; ------------------------------------------------------------------
    ;; Ctrl+C: a child process gets it; the shell must survive it

    (define (install-interrupt-handler!)
      (set-interrupt-handler! 'record))

    ;; ------------------------------------------------------------------
    ;; the prompt: venv python version, project version, git branch, cwd

    (define-record-type prompt-info
      (make-prompt-info cwd venv project git)
      prompt-info?
      (cwd info-cwd)
      (venv info-venv)
      (project info-project)
      (git info-git))

    (define info-cache #f)

    (define (capture argv cwd)
      (guard (e (#t #f))
        (let ((r (run-program/capture argv `((work-dir ,cwd)))))
          (and r (eqv? (car r) 0) (cadr r)))))

    ;; the directory of the first ancestor (or cwd) containing name
    (define (find-upwards cwd names)
      (let loop ((wd cwd))
        (cond ((let check ((ns names))
                 (cond ((null? ns) #f)
                       ((directory? (path-join wd (car ns))) (path-join wd (car ns)))
                       (else (check (cdr ns)))))
               => (lambda (found) found))
              ((path-ismount wd) #f)
              (else (let ((up (path-dirname wd)))
                      (if (string=? up wd) #f (loop up)))))))

    (define (info-venv-of cwd)
      (let* ((venv (find-upwards cwd '("venv" ".venv")))
             (python (and venv (find-executable-in (path-join venv (if is-win? "Scripts" "bin")) "python")))
             (out (and python (capture (list python "--version") cwd))))
        (if out
            (let ((parts (string-split-ws out)))
              (if (> (length parts) 1) (string-append "py=" (cadr parts)) ""))
            "")))

    (define (info-project-of cwd)
      (let ((file (path-join cwd "pyproject.toml")))
        (if (file? file)
            (guard (e (#t ""))
              (let* ((cfg (call-with-input-file file toml-read))
                     (project (and (list? cfg) (toml-ref cfg "project")))
                     (version (and (list? project) (toml-ref project "version"))))
                (if (string? version) (string-append "pr=" version) "")))
            "")))

    ;; (branch . modified?) or #f
    (define (info-git-of cwd)
      (and (find-upwards cwd '(".git"))
           (let ((out (capture '("git" "status" "-s" "-b") cwd)))
             (and out
                  (let ((lines (splitlines out)))
                    (and (pair? lines)
                         (let* ((first (string-strip (substring (car lines) 2 (string-length (car lines))))))
                           (cons (if (string-starts? (car lines) "## No commits yet on")
                                     (car (last-pair* (string-split-on first " ")))
                                     (car (string-split-on first ".")))
                                 (pair? (cdr lines))))))))))

    (define (last-pair* lst) (if (null? (cdr lst)) lst (last-pair* (cdr lst))))

    (define (prompt-info sh)
      (let ((cwd (shell-cwd sh))
            (ses (shell-session sh)))
        (when (or (not info-cache) (session-prompt-dirty? ses) (not (string=? (info-cwd info-cache) cwd)))
          (set! info-cache (make-prompt-info cwd (info-venv-of cwd) (info-project-of cwd) (info-git-of cwd)))
          (session-prompt-dirty-set! ses #f))
        info-cache))

    (define (max-line-length) (- (terminal-columns) 1))

    (define (prompt-string sh)
      (let* ((info (prompt-info sh))
             (cwd (shell-cwd sh))
             (parts (string-append
                     (if (string=? (info-venv info) "") "" (string-append (info-venv info) " "))
                     (if (string=? (info-project info) "") "" (string-append (info-project info) " "))))
             (git (info-git info))
             (s (string-append parts
                               (if git
                                   (string-append (if (cdr git) (string-append esc "[31m" (car git) "*")
                                                      (string-append esc "[32m" (car git)))
                                                  esc "[0m ")
                                   "")))
             (clean (string-append parts (if git (string-append (car git) (if (cdr git) "*" "") " ") "")))
             (width (max-line-length)))
        (if (> (+ (string-length clean) (string-length cwd)) width)
            (let ((avail (- width (string-length clean) 3)))
              (if (> avail 0)
                  (string-append s esc "[38;5;87m..."
                                 (substring cwd (max 0 (- (string-length cwd) avail)) (string-length cwd))
                                 esc "[0m")
                  (string-append s esc "[38;5;87m" cwd esc "[0m")))
            (string-append s esc "[38;5;87m" cwd esc "[0m"))))

    ;; ------------------------------------------------------------------
    ;; the history file: pairs of lines (directory, command)

    (define (load-history! sh file)
      (let ((ses (shell-session sh)))
        (session-history-file-set! ses file)
        (when (file? file)
          (let* ((lines (guard (e (#t '())) (splitlines (decode-bytes (read-file-bytes file)))))
                 (entries (let loop ((ls lines) (acc '()))
                            (if (or (null? ls) (null? (cdr ls)))
                                (reverse acc)
                                (loop (cddr ls) (cons (cons (string-strip (car ls)) (string-strip (cadr ls))) acc)))))
                 (entries
                  (if (> (length entries) 1000)
                      ;; compress the older entries: sorted, without duplicates
                      (let* ((cut (- (length entries) 1000))
                             (older (list-head entries cut))
                             (newer (list-tail entries cut))
                             (older (map (lambda (s) (let ((i (string-index-of s "\n")))
                                                       (cons (substring s 0 i) (substring s (+ i 1) (string-length s)))))
                                         (sort-strings (delete-duplicates
                                                        (map (lambda (e) (string-append (car e) "\n" (cdr e))) older)))))
                             (all (append older newer)))
                        (guard (e (#t #f))
                          (call-with-output-file file
                            (lambda (p)
                              (for-each (lambda (e)
                                          (write-string (car e) p) (newline p)
                                          (write-string (string-replace* (cdr e) "\n" " ") p) (newline p))
                                        all))))
                        all)
                      entries))
                 (local (session-local-history ses)))
            (session-history-set! ses (map cdr entries))
            (let loop ((es entries) (i 0))
              (unless (null? es)
                (hash-table-set! local (caar es)
                                 (cons (cons i (cdar es)) (hash-table-ref/default local (caar es) '())))
                (loop (cdr es) (+ i 1))))
            (for-each (lambda (k) (hash-table-set! local k (reverse (hash-table-ref local k))))
                      (hash-table-keys local))))))

    (define (list-head lst n) (if (= n 0) '() (cons (car lst) (list-head (cdr lst) (- n 1)))))

    ;; ------------------------------------------------------------------
    ;; the line editor

    (define-record-type editor
      (make-editor sh line index search-active search-query search-pos tabbed)
      editor?
      (sh ed-sh)
      (line ed-line ed-line-set!)
      (index ed-index ed-index-set!)
      (search-active ed-search? ed-search-set!)
      (search-query ed-query ed-query-set!)
      (search-pos ed-pos ed-pos-set!)
      (tabbed ed-tabbed? ed-tabbed-set!))

    (define (outp ed) (shell-outp (ed-sh ed)))
    (define (emit ed . strings) (for-each (lambda (s) (write-string s (outp ed))) strings))
    (define (flush ed) (flush-output-port (outp ed)))

    (define (set-line! ed line) (ed-line-set! ed line) (ed-index-set! ed (string-length line)))

    (define (redraw-line ed)
      (let* ((max-len (max-line-length))
             (line (ed-line ed))
             (index (ed-index ed)))
        (emit ed esc "[1000D")
        (let-values (((shown idx)
                      (if (> (string-length line) max-len)
                          (let* ((start (- index (quotient max-len 2)))
                                 (end (+ index (quotient max-len 2))))
                            (cond ((< start 0) (set! start 0) (set! end max-len))
                                  ((> end (string-length line))
                                   (set! end (string-length line))
                                   (set! start (- end max-len))))
                            (values (substring line start end) (- index start)))
                          (values line index))))
          (emit ed shown esc "[0K")
          (when (< index (string-length line))
            (emit ed esc "[1000D")
            (when (> idx 0) (emit ed esc "[" (number->string idx) "C"))))
        (flush ed)))

    (define (local-entries ed)
      (hash-table-ref/default (session-local-history (shell-session (ed-sh ed)))
                              (shell-cwd (ed-sh ed)) '()))

    ;; (values pos cmd) of the newest match at or before from (-1: the end)
    (define (search-match ed query from)
      (let* ((entries (list->vector (local-entries ed)))
             (n (vector-length entries))
             (q (string-downcase query)))
        (if (= n 0)
            (values #f #f)
            (let loop ((i (if (or (= from -1) (>= from n)) (- n 1) from)))
              (cond ((< i 0) (values #f #f))
                    ((string-contains? (string-downcase (cdr (vector-ref entries i))) q)
                     (values i (cdr (vector-ref entries i))))
                    (else (loop (- i 1))))))))

    (define (search-redraw ed query match)
      (let* ((prefix (string-append "(reverse-i-search)`" query "': "))
             (visible (or match ""))
             (avail (max 0 (- (max-line-length) (string-length prefix))))
             (shown (cond ((> (string-length visible) avail) (substring visible 0 avail))
                          ((and match (not (string=? query "")) (string-index-of (string-downcase match) (string-downcase query)))
                           => (lambda (i)
                                (string-append (substring match 0 i) esc "[1m" esc "[4m"
                                               (substring match i (+ i (string-length query)))
                                               esc "[0m"
                                               (substring match (+ i (string-length query)) (string-length match)))))
                          (else visible))))
        (emit ed esc "[1000D" prefix shown esc "[0K")
        (flush ed)))

    (define (search-entry ed)
      (let ((entries (local-entries ed))
            (pos (ed-pos ed)))
        (and pos (>= pos 0) (< pos (length entries)) (cdr (list-ref entries pos)))))

    (define (end-search! ed)
      (ed-search-set! ed #f)
      (ed-query-set! ed "")
      (ed-pos-set! ed -1))

    ;; handle a key in search mode; #t when consumed
    (define (search-key ed key)
      (define (older)
        (let ((next (if (> (ed-pos ed) 0) (- (ed-pos ed) 1) -1)))
          (let-values (((pos match) (search-match ed (ed-query ed) next)))
            (when pos (ed-pos-set! ed pos))
            (search-redraw ed (ed-query ed) (and pos match)))))
      (define (requery)
        (let-values (((pos match) (search-match ed (ed-query ed) -1)))
          (ed-pos-set! ed (or pos -1))
          (search-redraw ed (ed-query ed) match)))
      (cond ((memq key '(ctrl-r up)) (older) #t)
            ((eq? key 'backspace)
             (let ((q (ed-query ed)))
               (ed-query-set! ed (if (string=? q "") q (substring q 0 (- (string-length q) 1)))))
             (requery) #t)
            ((memq key '(lf cr))
             (let ((cmd (or (search-entry ed) "")))
               (end-search! ed)
               (set-line! ed cmd)
               (redraw-line ed))
             #t)
            ((eq? key 'down)
             (let* ((entries (list->vector (local-entries ed)))
                    (q (string-downcase (ed-query ed))))
               (if (and (ed-pos ed) (< (ed-pos ed) (- (vector-length entries) 1)))
                   (let loop ((i (+ (ed-pos ed) 1)))
                     (cond ((>= i (vector-length entries)) (search-redraw ed (ed-query ed) #f))
                           ((string-contains? (string-downcase (cdr (vector-ref entries i))) q)
                            (ed-pos-set! ed i)
                            (search-redraw ed (ed-query ed) (cdr (vector-ref entries i))))
                           (else (loop (+ i 1)))))
                   (search-redraw ed (ed-query ed) (search-entry ed))))
             #t)
            ((memq key '(esc ctrl-c))
             (end-search! ed)
             (emit ed esc "[1000D" esc "[0K")
             (set-line! ed "")
             (redraw-line ed)
             #t)
            ((char? key)
             (ed-query-set! ed (string-append (ed-query ed) (string key)))
             (requery)
             #t)
            (else
             ;; accept the match and handle the key normally
             (let ((cmd (or (search-entry ed) (ed-line ed))))
               (end-search! ed)
               (emit ed esc "[1000D" esc "[0K")
               (flush ed)
               (set-line! ed cmd))
             #f)))

    (define (complete! ed)
      (let* ((line (ed-line ed))
             (index (ed-index ed))
             (n (string-length line))
             (text-rest (cond ((string=? (string-strip line) "") #f)
                              ((= index n) (cons line ""))
                              ((char=? (string-ref line index) #\space)
                               (cons (substring line 0 index) (substring line index n)))
                              (else #f))))
        (when text-rest
          (let-values (((completed potentials) (complete-line (ed-sh ed) (car text-rest))))
            (cond ((and completed (not (string=? completed (car text-rest))))
                   (ed-line-set! ed (string-append completed (cdr text-rest)))
                   (ed-index-set! ed (string-length completed)))
                  ((ed-tabbed? ed)
                   (when (pair? potentials)
                     (let* ((s (string-join* (map path-basename potentials) " "))
                            (max-len (max-line-length))
                            (s (if (> (string-length s) (- max-len 1))
                                   (string-append (substring s 0 (max 0 (- max-len 4))) "...")
                                   s)))
                       (emit ed "\r\n" s "\r\n")))
                   (ed-tabbed-set! ed #f))
                  (else (ed-tabbed-set! ed #t)))))))

    (define (history-up! ed)
      (let* ((ses (shell-session (ed-sh ed)))
             (hist (session-history ses))
             (i (session-history-index ses)))
        (when (pair? hist)
          (cond ((= i -1)
                 (session-history-current-set! ses (ed-line ed))
                 (session-history-index-set! ses (- (length hist) 1))
                 (set-line! ed (list-ref hist (- (length hist) 1))))
                ((> i 0)
                 (session-history-index-set! ses (- i 1))
                 (set-line! ed (list-ref hist (- i 1))))))))

    (define (history-down! ed)
      (let* ((ses (shell-session (ed-sh ed)))
             (hist (session-history ses))
             (i (session-history-index ses)))
        (when (and (pair? hist) (not (= i -1)))
          (if (< i (- (length hist) 1))
              (begin (session-history-index-set! ses (+ i 1))
                     (set-line! ed (list-ref hist (+ i 1))))
              (begin (set-line! ed (session-history-current ses))
                     (session-history-index-set! ses -1)
                     (session-history-current-set! ses ""))))))

    (define (word-left line index)
      (if (= index 0)
          0
          (let* ((i (let loop ((i (- index 1))) (if (and (> i 0) (char=? (string-ref line i) #\space)) (loop (- i 1)) i)))
                 (i (let loop ((i i)) (if (and (> i 0) (not (char=? (string-ref line i) #\space))) (loop (- i 1)) i))))
            (if (> i 0) (+ i 1) i))))

    (define (word-right line index)
      (let* ((n (string-length line))
             (i (let loop ((i (+ index 1))) (if (and (< i n) (not (char=? (string-ref line i) #\space))) (loop (+ i 1)) i)))
             (i (let loop ((i i)) (if (and (< i n) (char=? (string-ref line i) #\space)) (loop (+ i 1)) i))))
        (min i n)))

    ;; run the entered line with the terminal in its normal mode; #f to exit
    (define (accept-line! ed)
      (let* ((sh (ed-sh ed))
             (line (ed-line ed)))
        (if (and (> (string-length line) 1) (char=? (string-ref line 0) #\!)
                 (let loop ((cs (cdr (string->list line))))
                   (or (null? cs) (and (char-numeric? (car cs)) (loop (cdr cs))))))
            ;; !n recalls history entry n
            (let ((hist (session-history (shell-session sh)))
                  (i (parse-int (substring line 1 (string-length line)))))
              (when (< i (length hist)) (set-line! ed (list-ref hist i)))
              #t)
            (begin
              (terminal-raw-off!)
              (println (shell-outs sh))
              (let ((continue?
                     (guard (e ((command-failed? e) #t)
                               (#t (println (shell-oute sh) (report-error e)) #t))
                       (shell-execute sh line))))
                (report-finished-jobs sh)
                (when continue?
                  (print-to (shell-outp sh) (prompt-string sh) "\n"))
                (set-line! ed "")
                continue?)))))

    ;; the interactive loop
    ;; apply an editing key to the line
    (define (edit-key! ed key)
      (let* ((sh (ed-sh ed))
             (line (ed-line ed))
             (index (ed-index ed))
             (n (string-length line)))
        (case (if (pair? key) 'other key)
          ((esc)
           (set-line! ed "")
           (session-history-index-set! (shell-session sh) -1)
           (session-history-current-set! (shell-session sh) ""))
          ((backspace ctrl-h)
           (when (> index 0)
             (ed-line-set! ed (string-append (substring line 0 (- index 1)) (substring line index n)))
             (ed-index-set! ed (- index 1))))
          ((ctrl-w)
           ;; delete the word before the cursor
           (let* ((i (let l ((i (- index 1)))
                       (if (and (>= i 0) (char=? (string-ref line i) #\space)) (l (- i 1)) i)))
                  (i (let l ((i i))
                       (if (and (>= i 0) (not (char=? (string-ref line i) #\space))) (l (- i 1)) i)))
                  (i (+ i 1)))
             (ed-line-set! ed (string-append (substring line 0 i) (substring line index n)))
             (ed-index-set! ed i)))
          ((left) (ed-index-set! ed (max 0 (- index 1))))
          ((right) (ed-index-set! ed (min n (+ index 1))))
          ((delete)
           (when (< index n)
             (ed-line-set! ed (string-append (substring line 0 index) (substring line (+ index 1) n)))))
          ((home ctrl-a) (ed-index-set! ed 0))
          ((end ctrl-e) (ed-index-set! ed n))
          ((up) (history-up! ed))
          ((down) (history-down! ed))
          ((ctrl-left) (ed-index-set! ed (word-left line index)))
          ((ctrl-right) (ed-index-set! ed (word-right line index)))
          ((ctrl-k) (ed-line-set! ed (substring line 0 index)))
          ((ctrl-u)
           (ed-line-set! ed (substring line index n))
           (ed-index-set! ed 0))
          (else
           (when (char? key)
             (ed-line-set! ed (string-append (substring line 0 index) (string key) (substring line index n)))
             (ed-index-set! ed (+ index 1)))))))

    ;; handle a key; #f when the shell should exit
    (define (handle-key! ed key)
      (let ((sh (ed-sh ed))
            (line (ed-line ed)))
        (if (eq? key 'tab) (complete! ed) (ed-tabbed-set! ed #f))
        (case (if (pair? key) 'other key)
          ((ctrl-r)
           (ed-search-set! ed #t) (ed-query-set! ed "") (ed-pos-set! ed -1)
           (search-redraw ed "" #f)
           #t)
          ((ctrl-c)
           ;; Ctrl+C on an empty line exits, else it discards the line
           (if (string=? line "")
               #f
               (begin
                 (emit ed "\r\n" (prompt-string sh) "\r\n")
                 (set-line! ed "")
                 (redraw-line ed)
                 #t)))
          ((ctrl-d) (if (string=? line "") #f (begin (redraw-line ed) #t)))
          ((lf cr)
           (and (accept-line! ed)
                (begin (terminal-raw-on!) (redraw-line ed) #t)))
          ((tab) (redraw-line ed) #t)
          (else (edit-key! ed key) (redraw-line ed) #t))))

    ;; the interactive loop
    (define (run-interactive sh)
      (let ((ed (make-editor sh "" 0 #f "" -1 #f)))
        (print-to (shell-outp sh) (prompt-string sh) "\n")
        (parameterize ((cooked-wrapper (lambda (thunk) (terminal-raw-off!) (thunk))))
          (dynamic-wind
            (lambda () #f)
            (lambda ()
              (let loop ()
                (terminal-raw-on!)
                (let ((key (read-key)))
                  (cond ((not key) (loop))
                        ((and (ed-search? ed) (search-key ed key)) (loop))
                        ((handle-key! ed key) (loop))
                        (else #f)))))
            terminal-raw-off!))))

    ;; without a terminal: execute the lines of standard input
    (define (run-lines sh port)
      (let loop ()
        (let ((line (read-line port)))
          (unless (eof-object? line)
            (when (guard (e ((command-failed? e) #t)
                            (#t (println (shell-oute sh) (report-error e)) #t))
                    (shell-execute sh line #f))
              (report-finished-jobs sh)
              (loop))))))

    ;; a root shell with the user's configuration (~/.dabshell) and history
    (define (start-shell interactive?)
      (let ((sh (make-root-shell)))
        (when interactive? (set-terminal-title! sh "dabshell"))
        (let ((cfg (path-join (home-directory) ".dabshell")))
          (when (file? cfg)
            (guard (e ((command-failed? e) #f)
                      (#t (println (shell-oute sh) (report-error e))))
              (shell-execute sh (string-append "source " (quote-arg cfg)) #f))))
        (when interactive?
          (load-history! sh (path-join (home-directory) ".dabshell-history")))
        sh))))
