;; dabshell completion: completing the last token of a command line with
;; commands, files and directories, and executables.

(define-library (dabshell completion)
  (export last-token-start split-path-word common-prefix render-completion
          complete-line complete-word)
  (import (scheme base)
          (scheme char)
          (only (srfi 1) filter any)
          (scm fs)
          (dabshell util)
          (dabshell core))
  (begin

    ;; (values start open-quote) for the last token of line; open-quote is
    ;; #\" or #\' when that quote is still open, else #f
    (define (last-token-start line)
      (let ((n (string-length line)))
        (let loop ((i 0) (start #f) (dq #f) (sq #f))
          (if (>= i n)
              (values (or start n) (cond (dq #\") (sq #\') (else #f)))
              (let ((ch (string-ref line i)))
                (cond (dq (cond ((and (char=? ch #\\) (< (+ i 1) n) (memv (string-ref line (+ i 1)) '(#\" #\\)))
                                 (loop (+ i 2) start dq sq))
                                ((char=? ch #\") (loop (+ i 1) start #f sq))
                                (else (loop (+ i 1) start dq sq))))
                      (sq (loop (+ i 1) start dq (not (char=? ch #\'))))
                      ((char=? ch #\space) (loop (+ i 1) #f dq sq))
                      (else (loop (+ i 1) (or start i) (char=? ch #\") (char=? ch #\')))))))))

    ;; (dir-part . base) of a partial path, or #f for an incomplete UNC root
    (define (split-path-word word win? cwd-drive)
      (define (sep? c) (or (char=? c #\/) (and win? (char=? c #\\))))
      (let ((n (string-length word)))
        (cond ((and win? (>= n 2) (sep? (string-ref word 0)) (sep? (string-ref word 1))
                    (< (length (split-seps (substring word 2 n) sep?)) 3))
               #f)
              (else
               (let* ((word (if (and win? (> n 0) (sep? (string-ref word 0))
                                     (not (and (>= n 2) (sep? (string-ref word 1)))))
                                (string-append cwd-drive word)
                                word))
                      (n (string-length word))
                      (idx (let loop ((i (- n 1))) (cond ((< i 0) -1) ((sep? (string-ref word i)) i) (else (loop (- i 1))))))
                      (idx (if (and win? (< idx 2) (>= n 2) (char=? (string-ref word 1) #\:)
                                    (char-alphabetic? (string-ref word 0)))
                               (max idx 1)
                               idx)))
                 (cons (substring word 0 (+ idx 1)) (substring word (+ idx 1) n)))))))

    (define (split-seps s sep?)
      (let ((n (string-length s)))
        (let loop ((i 0) (start 0) (acc '()))
          (cond ((>= i n) (reverse (cons (substring s start n) acc)))
                ((sep? (string-ref s i)) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
                (else (loop (+ i 1) start acc))))))

    ;; longest common prefix (case-insensitive on Windows)
    (define (common-prefix words win?)
      (let ((m (apply min (map string-length words))))
        (let loop ((i 0))
          (if (and (< i m)
                   (let ((c (string-ref (car words) i)))
                     (every* (lambda (w) (if win?
                                             (char=? (char-downcase (string-ref w i)) (char-downcase c))
                                             (char=? (string-ref w i) c)))
                             words)))
              (loop (+ i 1))
              (substring (car words) 0 i)))))

    (define (every* pred lst) (or (null? lst) (and (pred (car lst)) (every* pred (cdr lst)))))

    ;; render a completed path as command line text, quoting when needed;
    ;; a final completion closes the quote and adds a space
    (define (render-completion text final open-quote)
      (let ((needs (or open-quote (any (lambda (c) (string-contains? text (string c)))
                                       (string->list " '\"|&<>{")))))
        (if (not needs)
            (string-append text (if final " " ""))
            (let-values (((text quote)
                          (if (or (string-contains? text "'") (eqv? open-quote #\"))
                              (values (string-replace* (string-replace* text "\\" "\\\\") "\"" "\\\"") "\"")
                              (values text "'"))))
              (string-append quote text (if final (string-append quote " ") ""))))))

    ;; (values new-text potentials); new-text is #f when nothing matches
    (define (complete-line sh text)
      (let*-values (((start open-quote) (last-token-start text))
                    ((head) (substring text 0 start))
                    ((raw) (substring text start (string-length text)))
                    ((first?) (string=? (string-strip head) ""))
                    ((cmd _a) (split-command text sh #f))
                    ((word0) (if (string=? raw "")
                                 ""
                                 (let-values (((w _r) (split-command raw sh #f))) w)))
                    ((prefix word) (option-prefix word0 first?))
                    ((raw-rest) (if (string-starts? raw prefix)
                                    (substring raw (string-length prefix) (string-length raw))
                                    raw))
                    ((home) (shell-home sh))
                    ((tilde) (and (string-starts? raw-rest "~") (string-starts? word home)))
                    ((completed potentials dir?)
                     (complete-word sh word (and (string=? cmd "cd") (not first?)) (string=? prefix ""))))
        (if (not completed)
            (values #f potentials)
            (let* ((completed (if (and dir? (not (string-ends? completed "/"))
                                       (not (string-ends? completed (if is-win? "\\" "/"))))
                                  (string-append completed
                                                 (if (and is-win? (or (not (string-contains? word "/"))
                                                                      (string-contains? word "\\")))
                                                     "\\" "/"))
                                  completed))
                   (final (and (null? potentials) (not dir?)))
                   (token (if tilde
                              (string-append "~" (render-completion
                                                  (substring completed (string-length home) (string-length completed))
                                                  final open-quote))
                              (render-completion completed final open-quote))))
              (values (string-append head prefix token) potentials)))))

    ;; option=value: (values "option=" value) when the word looks like one
    (define (option-prefix word first?)
      (let ((i (string-index-of word "=")))
        (if (and (not first?) i (option-name? (substring word 0 i)))
            (values (substring word 0 (+ i 1)) (substring word (+ i 1) (string-length word)))
            (values "" word))))

    ;; -{0,2}[A-Za-z_][\w.-]*
    (define (option-name? s)
      (let* ((n (string-length s))
             (d (cond ((and (>= n 2) (string=? (substring s 0 2) "--")) 2)
                      ((and (>= n 1) (char=? (string-ref s 0) #\-)) 1)
                      (else 0))))
        (and (> n d)
             (let ((c (string-ref s d))) (or (char-alphabetic? c) (char=? c #\_)))
             (every* (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\_ #\. #\-))))
                     (string->list (substring s d n))))))

    ;; (values completed potentials dir?)
    (define (complete-word sh word only-dir with-commands)
      (let* ((with-commands (and with-commands (not only-dir) (not (string=? word ""))))
             (potentials (if with-commands
                             (filter (lambda (n) (string-starts? n word)) (env-names (shell-env sh)))
                             '()))
             (paths (complete-path sh word only-dir))
             (potentials (append potentials
                                 (filter (lambda (p) (not (member p potentials))) (map car paths))))
             (dirs (map car (filter cdr paths)))
             (potentials (if (and (null? potentials) with-commands)
                             (find-partial-executables (shell-cwd sh) word)
                             potentials)))
        (cond ((null? potentials) (values #f '() #f))
              ((null? (cdr potentials))
               (values (car potentials) '() (and (member (car potentials) dirs) #t)))
              (else (values (common-prefix potentials is-win?) potentials #f)))))

    ;; list of (path . dir?) of directory entries matching word
    (define (complete-path sh word only-dir)
      (let ((split (split-path-word word is-win? (car (path-splitdrive (shell-cwd sh))))))
        (if (not split)
            '()
            (let* ((dir-part (car split))
                   (base (if is-win? (string-downcase (cdr split)) (cdr split)))
                   (path (if (string=? dir-part "") (shell-cwd sh) (path-join (shell-cwd sh) dir-part)))
                   (entries (guard (e (#t '())) (directory-entries path)))
                   (names (sort-strings (map car entries))))
              (let loop ((ns names) (acc '()))
                (if (null? ns)
                    (reverse acc)
                    (let ((fname (car ns)))
                      (if (string-starts? (if is-win? (string-downcase fname) fname) base)
                          (let ((dir? (eq? (cdr (assoc fname entries)) 'directory)))
                            (if (and only-dir (not dir?))
                                (loop (cdr ns) acc)
                                (loop (cdr ns) (cons (cons (string-append dir-part fname) dir?) acc))))
                          (loop (cdr ns) acc)))))))))))
