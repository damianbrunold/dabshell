;; dabshell less: a pager for a file or piped input.

(define-library (dabshell less)
  (export)
  (import (scheme base)
          (dabshell util)
          (dabshell core)
          (dabshell keys))
  (begin

    ;; lines of text split at \r\n, \r or \n (Python's universal newlines)
    (define (text-lines text)
      (let ((n (string-length text)))
        (let loop ((i 0) (start 0) (acc '()))
          (cond ((>= i n)
                 (reverse (if (< start n) (cons (substring text start n) acc) acc)))
                ((char=? (string-ref text i) #\newline)
                 (loop (+ i 1) (+ i 1) (cons (substring text start i) acc)))
                ((char=? (string-ref text i) #\return)
                 (let ((next (if (and (< (+ i 1) n) (char=? (string-ref text (+ i 1)) #\newline))
                                 (+ i 2)
                                 (+ i 1))))
                   (loop next next (cons (substring text start i) acc))))
                (else (loop (+ i 1) start acc))))))

    (define (clip s cols) (if (> (string-length s) cols) (substring s 0 cols) s))

    ;; the lines to show, or #f after printing an error
    (define (less-input sh args)
      (cond ((pair? args)
             (let ((fn (shell-path sh (car args))))
               (cond ((not (path-exists?* fn))
                      (println (shell-oute sh) "ERR: " (car args) " not found") #f)
                     ((directory? fn)
                      (println (shell-oute sh) "ERR: " (car args) ": is a directory") #f)
                     (else (text-lines (decode-bytes (read-file-bytes fn)))))))
            ((stdin-string sh) => text-lines)
            (else (println (shell-oute sh) "ERR: less: no input") #f)))

    ;; page through lines with the keys of less until q
    (define (page sh lines)
      (let* ((out (shell-outs sh))
             (vt? (eq? out console-out))
             (rows (max 2 (- (terminal-rows) 1)))
             (cols (terminal-columns))
             (lines (list->vector lines))
             (total (vector-length lines))
             (last-top (max 0 (- total rows))))
        (define (draw top)
          (when vt? (write-string "\x1b;[2J\x1b;[H" out))
          (let loop ((i top))
            (when (< i (min total (+ top rows)))
              (write-string (clip (vector-ref lines i) cols) out)
              (write-string "\r\n" out)
              (loop (+ i 1))))
          (let* ((bottom (min (+ top rows) total))
                 (pct (if (<= total rows) 100 (quotient (* 100 bottom) total))))
            (write-string (clip (string-append ":  lines " (number->string (+ top 1)) "-"
                                               (number->string bottom) "/" (number->string total)
                                               " (" (number->string pct) "%)  q to quit")
                                cols)
                          out))
          (flush-output-port out))
        (with-raw-terminal
         (lambda ()
           (dynamic-wind
             (lambda () #f)
             (lambda ()
               (let loop ((top 0))
                 (draw top)
                 (let ((key (read-key)))
                   (cond ((memv key '(#\q #\Q ctrl-c ctrl-d esc)) #t)
                         ((memv key '(#\space #\f page-down ctrl-v))
                          (loop (min last-top (+ top rows))))
                         ((memv key '(#\b page-up)) (loop (max 0 (- top rows))))
                         ((memv key '(#\j cr lf down ctrl-n)) (loop (min last-top (+ top 1))))
                         ((memv key '(#\k up ctrl-p)) (loop (max 0 (- top 1))))
                         ((memv key '(#\g #\< home)) (loop 0))
                         ((memv key '(#\G #\> end)) (loop last-top))
                         (else (loop top))))))
             (lambda ()
               (write-string (if vt? "\x1b;[2J\x1b;[H" "\r\n") out)
               (flush-output-port out)))))))

    (define-command "less"
      "[<file>]   : pages through file or stdin (space/PgDn, b/PgUp, j/k/arrows, g/G/Home/End, q=quit)"
      (lambda (sh args)
        (let ((lines (less-input sh args)))
          (when lines
            (if (<= (length lines) (max 2 (- (terminal-rows) 1)))
                (let ((cols (terminal-columns)))
                  (for-each (lambda (l) (println (shell-outs sh) (clip l cols))) lines))
                (page sh lines))))))))
