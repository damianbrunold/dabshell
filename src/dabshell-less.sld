;; dabshell less: a pager for a file or piped input.

(define-library (dabshell less)
  (export)
  (import (scheme base)
          (dabshell util)
          (dabshell core)
          (dabshell keys))
  (begin

    ;; lines of text split at \r\n, \r or \n (Python's universal newlines)
    (define (text-lines text)
      (let ((n (string-length text)))
        (let loop ((i 0) (start 0) (acc '()))
          (cond ((>= i n)
                 (reverse (if (< start n) (cons (substring text start n) acc) acc)))
                ((char=? (string-ref text i) #\newline)
                 (loop (+ i 1) (+ i 1) (cons (substring text start i) acc)))
                ((char=? (string-ref text i) #\return)
                 (let ((next (if (and (< (+ i 1) n) (char=? (string-ref text (+ i 1)) #\newline))
                                 (+ i 2)
                                 (+ i 1))))
                   (loop next next (cons (substring text start i) acc))))
                (else (loop (+ i 1) start acc))))))

    ;; the lines to show, or #f after printing an error
    (define (less-input sh args)
      (cond ((pair? args)
             (let ((fn (shell-path sh (car args))))
               (cond ((not (path-exists?* fn))
                      (println (shell-oute sh) "ERR: " (car args) " not found") #f)
                     ((directory? fn)
                      (println (shell-oute sh) "ERR: " (car args) ": is a directory") #f)
                     (else (text-lines (decode-bytes (read-file-bytes fn)))))))
            ((stdin-string sh) => text-lines)
            (else (println (shell-oute sh) "ERR: less: no input") #f)))

    ;; a line as it is displayed: tabs expanded to 8 columns, other control
    ;; characters shown as ^X (like less)
    (define (display-line s)
      (let ((n (string-length s)))
        (let loop ((i 0) (col 0) (acc '()))
          (if (>= i n)
              (list->string (reverse acc))
              (let* ((c (string-ref s i)) (v (char->integer c)))
                (cond ((char=? c #\tab)
                       (let ((w (- 8 (remainder col 8))))
                         (loop (+ i 1) (+ col w) (append (make-list w #\space) acc))))
                      ((or (< v 32) (= v 127))
                       (loop (+ i 1) (+ col 2)
                             (cons (integer->char (if (= v 127) 63 (+ v 64))) (cons #\^ acc))))
                      (else (loop (+ i 1) (+ col 1) (cons c acc)))))))))

    ;; the screen rows of lines (a vector of displayed lines) as a vector of
    ;; (line-index . text): long lines are wrapped at cols, or kept whole
    ;; when chopping
    (define (layout lines cols chop?)
      (let ((total (vector-length lines)))
        (let loop ((i 0) (acc '()))
          (if (>= i total)
              (list->vector (reverse acc))
              (let ((s (vector-ref lines i)))
                (if (or chop? (<= (string-length s) cols))
                    (loop (+ i 1) (cons (cons i s) acc))
                    (let wrap ((start 0) (acc acc))
                      (if (>= start (string-length s))
                          (loop (+ i 1) acc)
                          (wrap (+ start cols)
                                (cons (cons i (substring s start (min (string-length s) (+ start cols))))
                                      acc))))))))))

    ;; the part of s from column left that fits in cols
    (define (window s left cols)
      (let ((n (string-length s)))
        (if (>= left n) "" (substring s left (min n (+ left cols))))))

    ;; the first screen row of line index i
    (define (row-of-line rows i)
      (let loop ((r 0))
        (if (or (>= r (vector-length rows)) (>= (car (vector-ref rows r)) i))
            (min r (max 0 (- (vector-length rows) 1)))
            (loop (+ r 1)))))

    ;; page through lines with the keys of less until q; long lines wrap
    ;; unless chop? (-S; typing -S while paging toggles it)
    (define (page sh lines chop?)
      (let* ((out (shell-outs sh))
             (vt? (eq? out console-out))
             (lines (list->vector lines))
             (total (vector-length lines)))
        (define (draw rows top left nrows cols)
          (when vt? (write-string "\x1b;[2J\x1b;[H" out))
          (let ((bottom (min (vector-length rows) (+ top nrows))))
            (let loop ((r top))
              (when (< r bottom)
                (write-string (window (cdr (vector-ref rows r)) left cols) out)
                (write-string "\r\n" out)
                (loop (+ r 1))))
            (let* ((first (if (< top bottom) (+ (car (vector-ref rows top)) 1) 0))
                   (last (if (< top bottom) (+ (car (vector-ref rows (- bottom 1))) 1) 0))
                   (pct (if (>= bottom (vector-length rows))
                            100
                            (quotient (* 100 last) (max 1 total)))))
              (write-string (window (string-append ":  lines " (number->string first) "-"
                                                   (number->string last) "/" (number->string total)
                                                   " (" (number->string pct) "%)"
                                                   (if (> left 0)
                                                       (string-append " col " (number->string (+ left 1)))
                                                       "")
                                                   "  q to quit")
                                    0 cols)
                            out)))
          (flush-output-port out))
        (with-raw-terminal
         (lambda ()
           (dynamic-wind
             (lambda () #f)
             (lambda ()
               ;; rows are laid out again when the width or the mode changes
               ;; (cols #f), keeping the top line
               (let loop ((chop? chop?) (rows #f) (cols #f) (top 0) (left 0))
                 (let ((ncols (max 1 (terminal-columns)))
                       (nrows (max 1 (- (terminal-rows) 1))))
                   (if (not (and rows (eqv? cols ncols)))
                       (let ((new (layout lines ncols chop?)))
                         (loop chop? new ncols
                               (if (and rows (< top (vector-length rows)))
                                   (row-of-line new (car (vector-ref rows top)))
                                   0)
                               (if chop? left 0)))
                       (let* ((last-top (max 0 (- (vector-length rows) nrows)))
                              (top (min top last-top))
                              (shift (max 1 (quotient cols 2)))
                              (go (lambda (top) (loop chop? rows cols top left))))
                         (draw rows top left nrows cols)
                         (let ((key (read-key)))
                           (cond ((memv key '(#\q #\Q ctrl-c ctrl-d esc)) #t)
                                 ((memv key '(#\space #\f page-down ctrl-v))
                                  (go (min last-top (+ top nrows))))
                                 ((memv key '(#\b page-up)) (go (max 0 (- top nrows))))
                                 ((memv key '(#\j cr lf down ctrl-n)) (go (min last-top (+ top 1))))
                                 ((memv key '(#\k up ctrl-p)) (go (max 0 (- top 1))))
                                 ((memv key '(#\g #\< home)) (go 0))
                                 ((memv key '(#\G #\> end)) (go last-top))
                                 ((and chop? (eq? key 'right))
                                  (loop chop? rows cols top (+ left shift)))
                                 ((and chop? (eq? key 'left))
                                  (loop chop? rows cols top (max 0 (- left shift))))
                                 ((eqv? key #\-)
                                  (if (memv (read-key) '(#\S #\s))
                                      (loop (not chop?) rows #f top 0)
                                      (go top)))
                                 (else (go top)))))))))
             (lambda ()
               (write-string (if vt? "\x1b;[2J\x1b;[H" "\r\n") out)
               (flush-output-port out)))))))

    (define (remove-arg x lst)
      (cond ((null? lst) '())
            ((equal? (car lst) x) (remove-arg x (cdr lst)))
            (else (cons (car lst) (remove-arg x (cdr lst))))))

    (define-command "less"
      "[-S] [<file>]   : pages through file or stdin; long lines wrap, -S chops them (left/right scroll). Keys: space/PgDn, b/PgUp, j/k/arrows, g/G/Home/End, -S toggles chopping, q=quit"
      (lambda (sh args)
        (let* ((chop? (and (member "-S" args) #t))
               (lines (less-input sh (remove-arg "-S" args))))
          (when lines
            (let* ((shown (map display-line lines))
                   (cols (max 1 (terminal-columns))))
              (if (<= (vector-length (layout (list->vector shown) cols chop?))
                      (max 1 (- (terminal-rows) 1)))
                  (for-each (lambda (l) (println (shell-outs sh) (if chop? (window l 0 cols) l)))
                            shown)
                  (page sh shown chop?)))))))))
