;; dabshell awk: a small awk (patterns, actions, if/else, next, printf, a few
;; string functions; no arrays, loops or user functions), and the Python
;; number formatting it relies on (str(), repr() and %-formatting of floats).

(define-library (dabshell awk)
  (export py-float-repr py-float-parse py-repr-str py-format-float)
  (import (scheme base)
          (scheme char)
          (scheme inexact)
          (scm bytevector)
          (scm string)
          (dabshell util)
          (dabshell core))
  (begin

    ;; ------------------------------------------------------------------
    ;; Python number formatting

    (define (neg-float? x) (or (< x 0) (and (zero? x) (eqv? x -0.0))))

    ;; (values m e): positive exact r rounded to p+1 significant digits,
    ;; r ~ m * 10^(e-p) with 10^p <= m < 10^(p+1); half-even like Python
    (define (sig-digits r p)
      (let* ((e (let ((guess (exact (floor (/ (log (inexact r)) (log 10))))))
                  (let adjust ((e guess))
                    (cond ((> (expt 10 e) r) (adjust (- e 1)))
                          ((<= (expt 10 (+ e 1)) r) (adjust (+ e 1)))
                          (else e)))))
             (m (round (/ r (expt 10 (- e p))))))
        (if (= m (expt 10 (+ p 1)))
            (values (expt 10 p) (+ e 1))
            (values m e))))

    ;; digits of exact r >= 0 with p decimals ("3.14")
    (define (fixed-string r p alt)
      (let* ((n (round (* r (expt 10 p))))
             (s (number->string n))
             (s (if (<= (string-length s) p)
                    (string-append (make-string (- (+ p 1) (string-length s)) #\0) s)
                    s))
             (k (- (string-length s) p)))
        (cond ((> p 0) (string-append (substring s 0 k) "." (substring s k (string-length s))))
              (alt (string-append s "."))
              (else s))))

    (define (exponent-string e)
      (string-append (if (< e 0) "-" "+")
                     (let ((s (number->string (abs e))))
                       (if (< (string-length s) 2) (string-append "0" s) s))))

    ;; exponent notation of exact r >= 0 with p decimals ("1.50e+03")
    (define (exp-string r p alt)
      (if (zero? r)
          (string-append (fixed-string 0 p alt) "e+00")
          (let-values (((m e) (sig-digits r p)))
            (let ((d (number->string m)))
              (string-append (substring d 0 1)
                             (if (or (> p 0) alt) "." "")
                             (substring d 1 (string-length d))
                             "e" (exponent-string e))))))

    (define (strip-fraction-zeros s)
      (if (string-index-of s ".")
          (let* ((t (string-rstrip s "0")))
            (if (string-ends? t ".") (substring t 0 (- (string-length t) 1)) t))
          s))

    ;; %g of exact r >= 0 with precision p
    (define (general-string r p alt)
      (let ((p (if (= p 0) 1 p)))
        (let ((e (if (zero? r) 0 (let-values (((m e) (sig-digits r (- p 1)))) e))))
          (if (and (<= -4 e) (< e p))
              (let ((s (fixed-string r (- p 1 e) alt)))
                (if alt s (strip-fraction-zeros s)))
              (let* ((s (exp-string r (- p 1) alt))
                     (i (string-index-of s "e")))
                (if alt
                    s
                    (string-append (strip-fraction-zeros (substring s 0 i))
                                   (substring s i (string-length s)))))))))

    ;; the unsigned digits of float x for conversion conv (#\f #\e #\g, upper
    ;; case for capitals) with precision p (#f for the default 6)
    (define (py-format-float x conv p alt)
      (let ((p (or p 6))
            (up (char-upper-case? conv)))
        (cond ((nan? x) (if up "NAN" "nan"))
              ((infinite? x) (if up "INF" "inf"))
              (else
               (let* ((r (abs (exact x)))
                      (s (case (char-downcase conv)
                           ((#\f) (fixed-string r p alt))
                           ((#\e) (exp-string r p alt))
                           (else (general-string r p alt)))))
                 (if up (string-upcase s) s))))))

    ;; Python's repr(float): the shortest digits that read back as x
    (define (py-float-repr x)
      (cond ((nan? x) "nan")
            ((infinite? x) (if (> x 0) "inf" "-inf"))
            ((zero? x) (if (eqv? x -0.0) "-0.0" "0.0"))
            (else
             (let ((r (abs (exact x)))
                   (sign (if (< x 0) "-" "")))
               (let loop ((p 0))
                 (let-values (((m e) (sig-digits r p)))
                   (if (and (< p 16) (not (= (inexact (* m (expt 10 (- e p)))) (abs x))))
                       (loop (+ p 1))
                       (let ((d (strip-trailing-zeros (number->string m))))
                         (string-append sign (repr-layout d e))))))))))

    (define (strip-trailing-zeros d)
      (let ((t (string-rstrip d "0"))) (if (string=? t "") "0" t)))

    ;; digits d (d[0].d[1:] * 10^e) the way repr lays them out
    (define (repr-layout d e)
      (let ((n (string-length d)))
        (cond ((or (< e -4) (>= e 16))
               (string-append (substring d 0 1)
                              (if (> n 1) (string-append "." (substring d 1 n)) "")
                              "e" (exponent-string e)))
              ((< e 0) (string-append "0." (make-string (- (- e) 1) #\0) d))
              ((>= (+ e 1) n) (string-append d (make-string (- (+ e 1) n) #\0) ".0"))
              (else (string-append (substring d 0 (+ e 1)) "." (substring d (+ e 1) n))))))

    ;; the digits of t from i, single underscores allowed between digits:
    ;; (values value count end)
    (define (scan-digits t i)
      (let ((n (string-length t)))
        (let loop ((i i) (v 0) (k 0))
          (cond ((and (< i n) (char<=? #\0 (string-ref t i) #\9))
                 (loop (+ i 1) (+ (* v 10) (digit-value (string-ref t i))) (+ k 1)))
                ((and (> k 0) (< (+ i 1) n) (char=? (string-ref t i) #\_)
                      (char<=? #\0 (string-ref t (+ i 1)) #\9))
                 (loop (+ i 1) v k))
                (else (values v k i))))))

    ;; the exponent part of t at i ("e-5"): (values exponent ok? end)
    (define (scan-exponent t i)
      (let ((n (string-length t)))
        (if (and (< i n) (memv (string-ref t i) '(#\e #\E)))
            (let* ((k (+ i 1))
                   (sgn (and (< k n) (memv (string-ref t k) '(#\+ #\-)))))
              (let-values (((v c j) (scan-digits t (if sgn (+ k 1) k))))
                (values (if (and sgn (char=? (car sgn) #\-)) (- v) v) (> c 0) j)))
            (values 0 #t i))))

    ;; Python's float(s): a number, or #f if s is not a valid float literal
    (define (py-float-parse s)
      (let* ((t (string-strip s))
             (n (string-length t))
             (neg (and (> n 0) (char=? (string-ref t 0) #\-)))
             (i0 (if (and (> n 0) (memv (string-ref t 0) '(#\+ #\-))) 1 0))
             (body (string-downcase (substring t i0 n))))
        (cond
         ((member body '("inf" "infinity")) (if neg -inf.0 +inf.0))
         ((string=? body "nan") +nan.0)
         (else
          (let*-values (((iv ik i) (scan-digits t i0))
                        ((fv fk i) (if (and (< i n) (char=? (string-ref t i) #\.))
                                       (scan-digits t (+ i 1))
                                       (values 0 0 i)))
                        ((ev ok j) (scan-exponent t i)))
            (and (> (+ ik fk) 0) ok (= j n)
                 (let* ((mant (+ (* iv (expt 10 fk)) fv))
                        (scale (- ev fk))
                        (mag (cond ((zero? mant) 0.0)
                                   ((> scale 400) +inf.0)
                                   ((< scale -800) 0.0)
                                   (else (inexact (* mant (expt 10 scale)))))))
                   (if neg (* -1.0 mag) mag))))))))

    ;; Python's repr() of a string
    (define (py-repr-str s)
      (let ((q (if (and (string-index-of s "'") (not (string-index-of s "\""))) #\" #\'))
            (out (open-output-string)))
        (write-char q out)
        (string-for-each
         (lambda (c)
           (cond ((char=? c q) (write-char #\\ out) (write-char c out))
                 ((char=? c #\\) (write-string "\\\\" out))
                 ((char=? c #\newline) (write-string "\\n" out))
                 ((char=? c #\return) (write-string "\\r" out))
                 ((char=? c #\tab) (write-string "\\t" out))
                 ((or (< (char->integer c) 32) (= (char->integer c) 127))
                  (let ((h (number->string (char->integer c) 16)))
                    (write-string (string-append "\\x" (if (< (string-length h) 2) "0" "") h) out)))
                 (else (write-char c out))))
         s)
        (write-char q out)
        (get-output-string out)))

    ;; ------------------------------------------------------------------
    ;; awk values: strings, exact integers and floats (Python int/float)

    (define-record-type awk-error
      (make-awk-error message)
      awk-error?
      (message awk-error-message))

    (define (awk-fail . parts) (raise (make-awk-error (apply string-append parts))))

    (define (awk-num v)
      (cond ((number? v) v)
            ((string? v)
             (let ((s (string-strip v)))
               (if (string=? s "")
                   0
                   (let ((f (py-float-parse s)))
                     (cond ((not f) 0)
                           ((and (integer? f) (not (infinite? f))
                                 (not (string-index-of s "."))
                                 (not (string-index-of s "e"))
                                 (not (string-index-of s "E")))
                            (exact f))
                           (else f))))))
            (else 0)))

    (define (awk-str v)
      (cond ((string? v) v)
            ((exact? v) (number->string v))
            ((and (integer? v) (not (infinite? v))) (number->string (exact v)))
            (else (py-general v))))

    ;; format(v, "g")
    (define (py-general v)
      (string-append (if (neg-float? v) "-" "") (py-format-float v #\g #f #f)))

    (define (awk-truthy? v)
      (if (string? v) (not (string=? v "")) (not (zero? v))))

    (define (awk-numlike? v)
      (or (number? v)
          (and (string? v) (not (string=? (string-strip v) "")) (py-float-parse v) #t)))

    ;; Python's int(x) of a number
    (define (awk-int v)
      (let ((x (awk-num v)))
        (cond ((exact? x) x)
              ((nan? x) (awk-fail "cannot convert float NaN to integer"))
              ((infinite? x) (awk-fail "cannot convert float infinity to integer"))
              (else (exact (truncate x))))))

    ;; arithmetic with Python's int/float rules
    (define (arith op a b)
      (if (and (exact? a) (exact? b))
          (op a b)
          (op (inexact a) (inexact b))))

    (define (check-divisor b)
      (when (zero? b) (awk-fail "division by zero")))

    ;; true division: a float, unless keep-int and the quotient is an integer
    (define (awk-divide a b keep-int)
      (check-divisor b)
      (if (and (exact? a) (exact? b))
          (let ((q (/ a b)))
            (if (and keep-int (integer? q)) q (inexact q)))
          (/ (inexact a) (inexact b))))

    ;; Python's %: the result has the sign of the divisor
    (define (awk-modulo a b)
      (check-divisor b)
      (if (and (exact? a) (exact? b))
          (floor-remainder a b)
          (let ((a (inexact a)) (b (inexact b)))
            (if (or (nan? a) (nan? b) (infinite? a))
                +nan.0
                (if (infinite? b)
                    (if (or (zero? a) (eq? (< a 0) (< b 0))) a b)
                    (let* ((ea (exact a)) (eb (exact b))
                           (r (- ea (* eb (floor (/ ea eb))))))
                      (if (zero? r) (if (< b 0) -0.0 0.0) (inexact r))))))))

    ;; ------------------------------------------------------------------
    ;; sprintf with Python's %-formatting of each conversion

    (define (pad-number sign prefix body flags width)
      (let* ((len (+ (string-length sign) (string-length prefix) (string-length body)))
             (fill (max 0 (- width len))))
        (cond ((memv #\- flags) (string-append sign prefix body (make-string fill #\space)))
              ((memv #\0 flags) (string-append sign prefix (make-string fill #\0) body))
              (else (string-append (make-string fill #\space) sign prefix body)))))

    (define (pad-string s flags width)
      (let ((fill (max 0 (- width (string-length s)))))
        (if (memv #\- flags)
            (string-append s (make-string fill #\space))
            (string-append (make-string fill #\space) s))))

    (define (sign-of neg flags)
      (cond (neg "-") ((memv #\+ flags) "+") ((memv #\space flags) " ") (else "")))

    ;; one conversion; flags is a list of chars, width a number, prec a number or #f
    (define (format-one conv flags width prec arg)
      (case conv
        ((#\d #\i #\x #\X #\o)
         (let* ((n (awk-int arg))
                (digits (case conv
                          ((#\x) (number->string (abs n) 16))
                          ((#\X) (string-upcase (number->string (abs n) 16)))
                          ((#\o) (number->string (abs n) 8))
                          (else (number->string (abs n)))))
                (digits (if (and prec (< (string-length digits) prec))
                            (string-append (make-string (- prec (string-length digits)) #\0) digits)
                            digits))
                (prefix (if (memv #\# flags)
                            (case conv ((#\x) "0x") ((#\X) "0X") ((#\o) "0o") (else ""))
                            "")))
           (pad-number (sign-of (< n 0) flags) prefix digits flags width)))
        ((#\f #\F #\e #\E #\g #\G)
         (let ((x (inexact (awk-num arg))))
           (pad-number (sign-of (and (not (nan? x)) (neg-float? x)) flags) ""
                       (py-format-float x conv prec (memv #\# flags)) flags width)))
        ((#\c)
         (let ((s (awk-str arg)))
           (pad-string (if (string=? s "") "" (substring s 0 1)) flags width)))
        (else
         (let ((s (awk-str arg)))
           (pad-string (if (and prec (< prec (string-length s))) (substring s 0 prec) s)
                       flags width)))))

    (define (awk-sprintf fmt args)
      (let ((n (string-length fmt))
            (out (open-output-string)))
        (define (digit-at? j) (and (< j n) (char<=? #\0 (string-ref fmt j) #\9)))
        (define (skip-digits j) (if (digit-at? j) (skip-digits (+ j 1)) j))
        (let loop ((i 0) (args args))
          (cond
           ((>= i n) (get-output-string out))
           ((not (char=? (string-ref fmt i) #\%))
            (write-char (string-ref fmt i) out)
            (loop (+ i 1) args))
           ((and (< (+ i 1) n) (char=? (string-ref fmt (+ i 1)) #\%))
            (write-char #\% out)
            (loop (+ i 2) args))
           (else
            (let* ((f-end (let skip ((j (+ i 1)))
                            (if (and (< j n) (memv (string-ref fmt j) '(#\- #\+ #\space #\0 #\#)))
                                (skip (+ j 1))
                                j)))
                   (w-end (skip-digits f-end))
                   (p-end (if (and (< w-end n) (char=? (string-ref fmt w-end) #\.))
                              (skip-digits (+ w-end 1))
                              w-end)))
              (if (>= p-end n)
                  (begin (write-string (substring fmt i n) out)
                         (get-output-string out))
                  (let* ((conv (string-ref fmt p-end))
                         (spec (substring fmt i (+ p-end 1)))
                         (flags (string->list (substring fmt (+ i 1) f-end)))
                         (width (if (> w-end f-end) (string->number (substring fmt f-end w-end)) 0))
                         (prec (and (> p-end w-end)
                                    (or (string->number (substring fmt (+ w-end 1) p-end)) 0)))
                         (arg (if (null? args) "" (car args))))
                    (write-string
                     (if (memv conv '(#\d #\i #\f #\F #\e #\E #\g #\G #\x #\X #\o #\c #\s))
                         (guard (e ((awk-error? e) spec))
                           (format-one conv flags width prec arg))
                         spec)
                     out)
                    (loop (+ p-end 1) (if (null? args) args (cdr args)))))))))))

    ;; ------------------------------------------------------------------
    ;; lexer: a list of tokens (kind . value); kinds are strings as in Python

    (define keywords '("BEGIN" "END" "if" "else" "next" "print" "printf"))

    (define (ascii-digit? c) (char<=? #\0 c #\9))

    (define (awk-lex src)
      (let ((n (string-length src)))
        (define (at i) (string-ref src i))
        (let loop ((i 0) (expect-regex #t) (toks '()))
          (if (>= i n)
              (reverse (cons (cons "EOF" #f) toks))
              (let ((ch (at i)))
                (cond
                 ((memv ch '(#\space #\tab)) (loop (+ i 1) expect-regex toks))
                 ((memv ch '(#\newline #\;))
                  (loop (+ i 1) #t (cons (cons "SEP" (string ch)) toks)))
                 ((char=? ch #\#)
                  (let skip ((j i))
                    (if (and (< j n) (not (char=? (at j) #\newline)))
                        (skip (+ j 1))
                        (loop j expect-regex toks))))
                 ((or (ascii-digit? ch)
                      (and (char=? ch #\.) (< (+ i 1) n) (ascii-digit? (at (+ i 1)))))
                  (let* ((j (let scan ((j i))
                              (if (and (< j n) (or (ascii-digit? (at j)) (char=? (at j) #\.)))
                                  (scan (+ j 1))
                                  j)))
                         (j (if (and (< j n) (memv (at j) '(#\e #\E)))
                                (let* ((j (+ j 1))
                                       (j (if (and (< j n) (memv (at j) '(#\+ #\-))) (+ j 1) j)))
                                  (let scan ((j j))
                                    (if (and (< j n) (ascii-digit? (at j))) (scan (+ j 1)) j)))
                                j))
                         (text (substring src i j))
                         (value (if (or (string-index-of text ".") (string-index-of text "e")
                                        (string-index-of text "E"))
                                    (let ((f (py-float-parse text))) (if f (inexact f) 0))
                                    (string->number text))))
                    (loop j #f (cons (cons "NUM" value) toks))))
                 ((char=? ch #\")
                  (let ((s (open-output-string)))
                    (let scan ((j (+ i 1)))
                      (cond ((>= j n) (awk-fail "unterminated string in awk program"))
                            ((char=? (at j) #\")
                             (loop (+ j 1) #f (cons (cons "STR" (get-output-string s)) toks)))
                            ((and (char=? (at j) #\\) (< (+ j 1) n))
                             (let ((nxt (at (+ j 1))))
                               (write-char (case nxt
                                             ((#\n) #\newline)
                                             ((#\t) #\tab)
                                             ((#\r) #\return)
                                             (else nxt))
                                           s)
                               (scan (+ j 2))))
                            (else (write-char (at j) s) (scan (+ j 1)))))))
                 ((and (char=? ch #\/) expect-regex)
                  (let scan ((j (+ i 1)))
                    (cond ((>= j n) (awk-fail "unterminated regex in awk program"))
                          ((char=? (at j) #\/)
                           (loop (+ j 1) #f (cons (cons "REGEX" (substring src (+ i 1) j)) toks)))
                          ((and (char=? (at j) #\\) (< (+ j 1) n)) (scan (+ j 2)))
                          (else (scan (+ j 1))))))
                 ((or (char-alphabetic? ch) (char=? ch #\_))
                  (let* ((j (let scan ((j i))
                              (if (and (< j n) (or (char-alphabetic? (at j)) (char-numeric? (at j))
                                                   (char=? (at j) #\_)))
                                  (scan (+ j 1))
                                  j)))
                         (name (substring src i j)))
                    (loop j #f (cons (if (member name keywords) (cons name name) (cons "IDENT" name))
                                     toks))))
                 ((and (< (+ i 1) n)
                       (member (substring src i (+ i 2))
                               '("==" "!=" "<=" ">=" "&&" "||" "!~" "+=" "-=" "*=" "/=" "%=")))
                  (let ((two (substring src i (+ i 2))))
                    (loop (+ i 2) #t (cons (cons two two) toks))))
                 ((memv ch (string->list "+-*/%=<>!~,(){}$"))
                  (loop (+ i 1) (not (memv ch '(#\) #\}))) (cons (cons (string ch) (string ch)) toks)))
                 (else
                  (awk-fail "unexpected character " (py-repr-str (string ch)) " in awk program"))))))))

    ;; ------------------------------------------------------------------
    ;; parser: the AST is made of lists headed by symbols
    ;;   (prog rules) (rule pattern action) with pattern 'begin, 'end, #f or an expr
    ;;   statements: (print exprs) (printf exprs) (next) (block stmts) (if c t e) (expr e)
    ;;   expressions: (num v) (str s) (var name) (field e) (neg e) (not e)
    ;;                (binop op a b) (match lhs rhs negate) (regex text)
    ;;                (assign op target e) (call name args)

    (define (awk-parse tokens)
      (let ((toks (list->vector tokens)) (i 0))
        (define (peek) (car (vector-ref toks i)))
        (define (advance!) (let ((t (vector-ref toks i))) (set! i (+ i 1)) t))
        (define (accept kind) (and (equal? (peek) kind) (advance!)))
        (define (expect kind)
          (let ((t (advance!)))
            (unless (equal? (car t) kind)
              (awk-fail "awk: expected " (py-repr-str kind) ", got " (py-repr-str (car t))))
            t))
        (define (skip-seps) (when (equal? (peek) "SEP") (advance!) (skip-seps)))

        (define (parse-program)
          (skip-seps)
          (let loop ((rules '()))
            (if (equal? (peek) "EOF")
                (list 'prog (reverse rules))
                (let ((r (parse-rule)))
                  (skip-seps)
                  (loop (cons r rules))))))

        (define (parse-rule)
          (let ((pattern (cond ((accept "BEGIN") 'begin)
                               ((accept "END") 'end)
                               ((equal? (peek) "{") #f)
                               (else (parse-expr)))))
            (list 'rule pattern (and (equal? (peek) "{") (parse-block)))))

        (define (parse-block)
          (expect "{")
          (skip-seps)
          (let loop ((stmts '()))
            (if (equal? (peek) "}")
                (begin (advance!) (list 'block (reverse stmts)))
                (let ((stmts (cons (parse-stmt) stmts)))
                  (cond ((equal? (peek) "}") (loop stmts))
                        ((equal? (peek) "SEP") (skip-seps) (loop stmts))
                        ((equal? (peek) "EOF") (awk-fail "awk: unterminated block"))
                        (else (awk-fail "awk: expected ; or newline, got " (py-repr-str (peek)))))))))

        (define (parse-expr-list)
          (let loop ((exprs (list (parse-expr))))
            (if (accept ",") (loop (cons (parse-expr) exprs)) (reverse exprs))))

        (define (parse-stmt)
          (let ((k (peek)))
            (cond ((equal? k "if") (parse-if))
                  ((accept "print")
                   (list 'print (if (member (peek) '("SEP" "}" "EOF")) '() (parse-expr-list))))
                  ((accept "printf") (list 'printf (parse-expr-list)))
                  ((accept "next") (list 'next))
                  ((equal? k "{") (parse-block))
                  (else (list 'expr (parse-expr))))))

        (define (parse-if)
          (expect "if")
          (expect "(")
          (let ((c (parse-expr)))
            (expect ")")
            (skip-seps)
            (let* ((then-s (parse-stmt))
                   (save i))
              (skip-seps)
              (if (accept "else")
                  (begin (skip-seps) (list 'if c then-s (parse-stmt)))
                  (begin (set! i save) (list 'if c then-s #f))))))

        (define (parse-expr)
          (let ((lhs (parse-or)))
            (if (member (peek) '("=" "+=" "-=" "*=" "/=" "%="))
                (let ((op (car (advance!))))
                  (list 'assign op lhs (parse-expr)))
                lhs)))

        (define (parse-left-assoc next ops)
          (let loop ((left (next)))
            (if (member (peek) ops)
                (let ((op (car (advance!))))
                  (loop (list 'binop op left (next))))
                left)))

        (define (parse-or) (parse-left-assoc parse-and '("||")))
        (define (parse-and) (parse-left-assoc parse-not '("&&")))

        (define (parse-not)
          (if (accept "!") (list 'not (parse-not)) (parse-match)))

        (define (parse-match)
          (let loop ((left (parse-compare)))
            (if (member (peek) '("~" "!~"))
                (let* ((op (car (advance!)))
                       (rhs (if (equal? (peek) "REGEX")
                                (list 'regex (cdr (advance!)))
                                (parse-compare))))
                  (loop (list 'match left rhs (equal? op "!~"))))
                left)))

        (define (parse-compare)
          (let ((left (parse-concat)))
            (if (member (peek) '("==" "!=" "<" "<=" ">" ">="))
                (let ((op (car (advance!))))
                  (list 'binop op left (parse-concat)))
                left)))

        (define (parse-concat)
          (let loop ((left (parse-add)))
            (if (member (peek) '("IDENT" "NUM" "STR" "$" "("))
                (loop (list 'binop "concat" left (parse-add)))
                left)))

        (define (parse-add) (parse-left-assoc parse-mul '("+" "-")))
        (define (parse-mul) (parse-left-assoc parse-unary '("*" "/" "%")))

        (define (parse-unary)
          (cond ((accept "-") (list 'neg (parse-unary)))
                ((accept "+") (parse-unary))
                (else (parse-primary))))

        (define (parse-primary)
          (let* ((t (vector-ref toks i)) (k (car t)))
            (cond ((accept "NUM") (list 'num (cdr t)))
                  ((accept "STR") (list 'str (cdr t)))
                  ((accept "REGEX") (list 'match '(field (num 0)) (list 'regex (cdr t)) #f))
                  ((accept "$") (list 'field (parse-primary)))
                  ((accept "(")
                   (let ((e (parse-expr))) (expect ")") e))
                  ((accept "IDENT")
                   (if (accept "(")
                       (let ((args (if (equal? (peek) ")") '() (parse-expr-list))))
                         (expect ")")
                         (list 'call (cdr t) args))
                       (list 'var (cdr t))))
                  (else (awk-fail "awk: unexpected token in expression: " (py-repr-str k))))))

        (parse-program)))

    ;; ------------------------------------------------------------------
    ;; evaluator

    (define-record-type awk-state
      (make-awk-state fs ofs vars fields nr write-line write-raw)
      awk-state?
      (fs st-fs st-fs-set!)                 ; #f = whitespace
      (ofs st-ofs st-ofs-set!)
      (vars st-vars st-vars-set!)           ; alist name -> value
      (fields st-fields st-fields-set!)     ; vector: $0 $1 ...
      (nr st-nr st-nr-set!)
      (write-line st-write-line)
      (write-raw st-write-raw))

    (define (split-fields st line)
      (let ((fs (st-fs st)))
        (cond ((string=? line "") '())
              ((or (not fs) (string=? fs " ")) (string-split-ws line))
              ((string=? fs "") (awk-fail "empty separator"))
              (else (string-split-on line fs)))))

    (define (set-line! st line)
      (st-nr-set! st (+ (st-nr st) 1))
      (st-fields-set! st (list->vector (cons line (split-fields st line)))))

    (define (get-var st name)
      (cond ((string=? name "NR") (st-nr st))
            ((string=? name "NF") (- (vector-length (st-fields st)) 1))
            ((string=? name "FS") (or (st-fs st) " "))
            ((string=? name "OFS") (st-ofs st))
            (else (let ((p (assoc name (st-vars st)))) (if p (cdr p) "")))))

    (define (set-var! st name value)
      (cond ((string=? name "FS") (st-fs-set! st (awk-str value)))
            ((string=? name "OFS") (st-ofs-set! st (awk-str value)))
            ((string=? name "NR") (st-nr-set! st (awk-int value)))
            ((string=? name "NF") #f)
            (else
             (let ((p (assoc name (st-vars st))))
               (if p
                   (set-cdr! p value)
                   (st-vars-set! st (cons (cons name value) (st-vars st))))))))

    (define (get-field st idx-v)
      (let ((idx (awk-int idx-v)) (fields (st-fields st)))
        (if (or (< idx 0) (>= idx (vector-length fields))) "" (vector-ref fields idx))))

    (define (set-field! st idx-v value)
      (let ((idx (awk-int idx-v)))
        (when (>= idx 0)
          (let* ((old (vector->list (st-fields st)))
                 (fields (list->vector
                          (if (< idx (length old))
                              old
                              (append old (make-list (- (+ idx 1) (length old)) ""))))))
            (vector-set! fields idx (awk-str value))
            (st-fields-set!
             st
             (if (= idx 0)
                 (list->vector (cons (vector-ref fields 0) (split-fields st (vector-ref fields 0))))
                 (begin
                   (vector-set! fields 0 (string-join* (cdr (vector->list fields)) (st-ofs st)))
                   fields)))))))

    (define (regex-match? pattern text)
      (and (regex-search text pattern) #t))

    (define (bool->awk b) (if b 1 0))

    (define (compare op a b)
      (let-values (((av bv) (if (and (awk-numlike? a) (awk-numlike? b))
                                (values (awk-num a) (awk-num b))
                                (values (awk-str a) (awk-str b)))))
        (let ((num (number? av)))
          (bool->awk
           (cond ((string=? op "==") (if num (= av bv) (string=? av bv)))
                 ((string=? op "!=") (not (if num (= av bv) (string=? av bv))))
                 ((string=? op "<") (if num (< av bv) (string<? av bv)))
                 ((string=? op "<=") (if num (<= av bv) (string<=? av bv)))
                 ((string=? op ">") (if num (> av bv) (string>? av bv)))
                 (else (if num (>= av bv) (string>=? av bv))))))))

    (define (eval-expr st e)
      (case (car e)
        ((num str) (cadr e))
        ((var) (get-var st (cadr e)))
        ((field) (get-field st (eval-expr st (cadr e))))
        ((neg) (- (awk-num (eval-expr st (cadr e)))))
        ((not) (bool->awk (not (awk-truthy? (eval-expr st (cadr e))))))
        ((binop)
         (let ((op (cadr e)))
           (cond ((string=? op "&&")
                  (bool->awk (and (awk-truthy? (eval-expr st (caddr e)))
                                  (awk-truthy? (eval-expr st (cadddr e))))))
                 ((string=? op "||")
                  (bool->awk (or (awk-truthy? (eval-expr st (caddr e)))
                                 (awk-truthy? (eval-expr st (cadddr e))))))
                 (else
                  (let ((a (eval-expr st (caddr e)))
                        (b (eval-expr st (cadddr e))))
                    (cond ((string=? op "concat") (string-append (awk-str a) (awk-str b)))
                          ((member op '("+" "-" "*" "/" "%"))
                           (let ((an (awk-num a)) (bn (awk-num b)))
                             (cond ((string=? op "+") (arith + an bn))
                                   ((string=? op "-") (arith - an bn))
                                   ((string=? op "*") (arith * an bn))
                                   ((string=? op "/") (awk-divide an bn #t))
                                   (else (awk-modulo an bn)))))
                          (else (compare op a b))))))))
        ((match)
         (let* ((text (awk-str (eval-expr st (cadr e))))
                (rhs (caddr e))
                (pat (if (eq? (car rhs) 'regex) (cadr rhs) (awk-str (eval-expr st rhs))))
                (m (regex-match? pat text)))
           (bool->awk (if (cadddr e) (not m) m))))
        ((assign)
         (let* ((op (cadr e))
                (target (caddr e))
                (value (eval-expr st (cadddr e)))
                (new (if (string=? op "=")
                         value
                         (let ((on (awk-num (eval-expr st target)))
                               (nn (awk-num value)))
                           (cond ((string=? op "+=") (arith + on nn))
                                 ((string=? op "-=") (arith - on nn))
                                 ((string=? op "*=") (arith * on nn))
                                 ((string=? op "/=") (awk-divide on nn #f))
                                 (else (awk-modulo on nn)))))))
           (case (car target)
             ((var) (set-var! st (cadr target) new))
             ((field) (set-field! st (eval-expr st (cadr target)) new))
             (else (awk-fail "invalid assignment target")))
           new))
        ((call)
         (call-function st (cadr e) (map (lambda (a) (eval-expr st a)) (caddr e))))
        (else (awk-fail "unknown expr " (symbol->string (car e))))))

    (define (arg-ref name args k)
      (if (< k (length args))
          (list-ref args k)
          (awk-fail name ": missing argument")))

    (define (call-function st name args)
      (cond
       ((string=? name "length")
        (string-length (awk-str (if (null? args) (vector-ref (st-fields st) 0) (car args)))))
       ((string=? name "substr")
        (let* ((s (awk-str (arg-ref name args 0)))
               (n (string-length s))
               (start (awk-int (arg-ref name args 1)))
               (lo (min n (max (- start 1) 0)))
               (hi (if (>= (length args) 3)
                       (min n (+ start -1 (awk-int (list-ref args 2))))
                       n)))
          (if (> hi lo) (substring s lo hi) "")))
       ((string=? name "index")
        (let ((s (awk-str (arg-ref name args 0)))
              (t (awk-str (arg-ref name args 1))))
          (if (string=? t "")
              0
              (let ((p (string-index-of s t))) (if p (+ p 1) 0)))))
       ((string=? name "tolower") (string-downcase (awk-str (arg-ref name args 0))))
       ((string=? name "toupper") (string-upcase (awk-str (arg-ref name args 0))))
       ((string=? name "int") (awk-int (arg-ref name args 0)))
       ((string=? name "sprintf")
        (awk-sprintf (awk-str (arg-ref name args 0)) (cdr args)))
       (else (awk-fail "unknown function " (py-repr-str name)))))

    ;; statements; returns 'next when a next statement ran
    (define (exec-stmt st s)
      (case (car s)
        ((print)
         ((st-write-line st)
          (if (null? (cadr s))
              (vector-ref (st-fields st) 0)
              (string-join* (map (lambda (e) (awk-str (eval-expr st e))) (cadr s)) (st-ofs st))))
         #f)
        ((printf)
         (let ((vals (map (lambda (e) (eval-expr st e)) (cadr s))))
           ((st-write-raw st) (awk-sprintf (awk-str (car vals)) (cdr vals)))
           #f))
        ((next) 'next)
        ((block)
         (let loop ((stmts (cadr s)))
           (cond ((null? stmts) #f)
                 ((exec-stmt st (car stmts)) 'next)
                 (else (loop (cdr stmts))))))
        ((if)
         (cond ((awk-truthy? (eval-expr st (cadr s))) (exec-stmt st (caddr s)))
               ((cadddr s) (exec-stmt st (cadddr s)))
               (else #f)))
        (else (eval-expr st (cadr s)) #f)))

    (define (prog-rules prog) (cadr prog))

    (define (run-special! st prog which)
      (for-each (lambda (r)
                  (when (and (eq? (cadr r) which) (caddr r))
                    (exec-stmt st (caddr r))))
                (prog-rules prog)))

    (define (run-line! st prog line)
      (set-line! st line)
      (let loop ((rules (prog-rules prog)))
        (unless (null? rules)
          (let* ((r (car rules)) (pat (cadr r)) (action (caddr r)))
            (if (memq pat '(begin end))
                (loop (cdr rules))
                (let ((stop (and (or (not pat) (awk-truthy? (eval-expr st pat)))
                                 (if action
                                     (exec-stmt st action)
                                     (begin ((st-write-line st) (vector-ref (st-fields st) 0)) #f)))))
                  (unless stop (loop (cdr rules)))))))))

    ;; ------------------------------------------------------------------
    ;; the command

    ;; the lines of a file as Python's text mode reads them
    (define (file-lines path)
      (splitlines (utf8->string (read-file-bytes path))))

    (define (strip-line-end line) (string-rstrip (string-rstrip line "\n") "\r"))

    (define (awk-message e)
      (if (awk-error? e) (awk-error-message e) (report-error e)))

    (define-command "awk"
      "[-F<sep>] '<program>' [<file>...]   : pattern-action text processor (subset)"
      (lambda (sh args)
        (let parse ((args args) (fs #f) (program #f) (files '()))
          (cond
           ((and (pair? args) (string=? (car args) "-F"))
            (if (null? (cdr args))
                (println (shell-oute sh) "ERR: awk: -F requires an argument")
                (parse (cddr args) (cadr args) program files)))
           ((and (pair? args) (string-starts? (car args) "-F") (> (string-length (car args)) 2))
            (parse (cdr args) (substring (car args) 2 (string-length (car args))) program files))
           ((pair? args)
            (if program
                (parse (cdr args) fs program (cons (car args) files))
                (parse (cdr args) fs (car args) files)))
           ((not program) (println (shell-oute sh) "ERR: awk: missing program"))
           (else
            (let ((prog (guard (e (#t (println (shell-oute sh) "ERR: awk: " (awk-message e)) #f))
                          (awk-parse (awk-lex program)))))
              (when prog
                (let ((st (make-awk-state fs " " '() (vector "") 0
                                          (lambda (s) (println (shell-outs sh) s))
                                          (lambda (s) (print-to (shell-outs sh) s)))))
                  (guard (e (#t (println (shell-oute sh) "ERR: awk: " (awk-message e))))
                    (run-special! st prog 'begin)
                    (cond ((pair? files)
                           (for-each
                            (lambda (name)
                              (let ((path (shell-path sh name)))
                                (if (path-exists?* path)
                                    (for-each (lambda (line) (run-line! st prog line))
                                              (file-lines path))
                                    (println (shell-oute sh) "ERR: " path " not found"))))
                            (reverse files)))
                          ((stdin-lines sh)
                           (for-each (lambda (line) (run-line! st prog (strip-line-end line)))
                                     (stdin-lines sh))))
                    (run-special! st prog 'end))))))))))))
