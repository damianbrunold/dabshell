;; Tests of tab completion (port of TestCompletionHelpers and TestCompletion
;; of tests/test_dabshell.py).

(import (scheme base) (scheme process-context) (scm fs) (scm module) (scm test))
(define root (directory-name (directory-name (absolute-path (car (command-line))))))
(module-search-path! (append (list (join-path root "src") (join-path root "tests"))
                             (module-search-path)))
(import (dabshell util) (dabshell core) (dabshell builtins) (dabshell completion)
        (dabshell testing))

(define (lts line) (call-with-values (lambda () (last-token-start line)) list))

;; the directory separator completion appends to a directory (Python's
;; test expected "/", which only holds on POSIX)
(define sep (if is-win? "\\" "/"))

(test-runner-factory scm-test-runner)
(test-begin "completion")

(test-group "helpers"
  (test-equal '(3 #f) (lts "ls sr"))
  (test-equal '(3 #f) (lts "ls "))
  (test-equal '(3 #\') (lts "ls 'a b"))
  (test-equal '(3 #\") (lts "ls \"a b"))
  (test-equal '(9 #f) (lts "ls 'a b' c"))
  (test-equal '(3 #\') (lts "ls x='a b"))
  (test-equal '("src/" . "ma") (split-path-word "src/ma" #f ""))
  (test-equal '("" . "ma") (split-path-word "ma" #f ""))
  (test-equal '("/usr/" . "b") (split-path-word "/usr/b" #f ""))
  (test-equal '("C:\\" . "Program Fi") (split-path-word "\\Program Fi" #t "C:"))
  (test-equal '("D:/" . "Program Fi") (split-path-word "/Program Fi" #t "D:"))
  (test-equal '("C:\\" . "Us") (split-path-word "C:\\Us" #t ""))
  (test-equal '("C:" . "foo") (split-path-word "C:foo" #t ""))
  (test-equal '("a\\b/" . "c") (split-path-word "a\\b/c" #t ""))
  (test-equal '("\\\\srv\\share\\" . "di") (split-path-word "\\\\srv\\share\\di" #t "C:"))
  (test-equal #f (split-path-word "\\\\srv" #t "C:"))
  (test-equal #f (split-path-word "\\\\srv\\" #t "C:"))
  (test-equal #f (split-path-word "\\\\srv\\sh" #t "C:"))
  ;; Python bug fixed: an empty word got the drive prepended ("cd " -> "cd C:")
  (test-equal '("" . "") (split-path-word "" #t "C:"))
  (test-equal "ab" (common-prefix '("abc" "abd") #f))
  (test-equal "" (common-prefix '("Abc" "aBd") #f))
  (test-equal "Ab" (common-prefix '("Abc" "aBd") #t))
  (test-equal "src/" (render-completion "src/" #f #f))
  (test-equal "a.txt " (render-completion "a.txt" #t #f))
  (test-equal "'a b" (render-completion "a b" #f #f))
  (test-equal "'a b' " (render-completion "a b" #t #f))
  (test-equal "'ab" (render-completion "ab" #f #\'))
  (test-equal "\"it's\" " (render-completion "it's" #t #f))
  (test-equal "\"C:\\\\a b" (render-completion "C:\\a b" #f #\")))

(test-group "complete-line"
  (with-shell (lambda (t)
    (define (complete text)
      (let-values (((new potentials) (complete-line (tc-shell t) text))) new))
    (make-dirs (file-path t "Program Files"))
    (make-dirs (file-path t "Program Files (x86)"))
    (make-dirs (file-path t "src"))
    (for-each (lambda (n) (write-file t n "")) '("readme.txt" "src/main.py" "Program Files/a b.txt"))
    (test-equal (string-append "cat src" sep) (complete "cat sr"))
    (test-equal "cat readme.txt " (complete "cat rea"))
    (test-equal (string-append "cmd file=src" sep) (complete "cmd file=sr"))
    (test-equal "cmd --in=readme.txt " (complete "cmd --in=rea"))
    ;; an unquoted space splits the token
    (test-equal #f (complete "cmd file=Program Files/a"))
    (test-equal "cmd file='Program Files/a b.txt' " (complete "cmd file='Program Files/a"))
    (test-equal "cd 'Program Files" (complete "cd Prog"))
    (test-equal (string-append "cd 'Program Files (x86)" sep) (complete "cd 'Program Files ("))
    (test-equal "cat 'Program Files/a b.txt' " (complete "cat 'Program Files/a"))
    (test-equal (string-append "echo \"a b\" src" sep) (complete "echo \"a b\" sr"))
    ;; the separator follows the expanded word, which has the home's backslashes
    (test-equal (string-append "cat ~/src" sep) (complete "cat ~/sr"))
    (test-equal (string-append "cd src" sep) (complete "cd s"))
    (test-equal #f (complete "cd rea"))
    (test-equal #f (complete "cat nothing"))
    (let-values (((new potentials) (complete-line (tc-shell t) "cd ")))
      (test-equal "cd " new)
      (test-equal '("Program Files" "Program Files (x86)" "src") potentials)))))

(test-end "completion")
(exit (if (zero? (last-run-failed-tests)) 0 1))
