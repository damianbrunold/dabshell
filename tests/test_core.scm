;; Tests of the shell core: quoting, variables, expressions, echo/print,
;; cd/pwd, aliases, options, pipes, redirects, &&, which/help, history,
;; time, environments, env overlays, scm runner (port of the corresponding
;; classes of tests/test_dabshell.py).

(import (scheme base) (scheme char) (scheme process-context) (scheme time)
        (only (srfi 1) filter) (scm fs) (scm module) (scm string) (scm test))
(define root (directory-name (directory-name (absolute-path (car (command-line))))))
(module-search-path! (append (list (join-path root "src") (join-path root "tests"))
                             (module-search-path)))
(import (dabshell util) (dabshell core) (dabshell builtins) (dabshell testing))

;; minimal stand-ins for grep and wc (owned by other libraries) so that the
;; pipe tests only exercise the core
(define-command "tgrep" "<text>   : test command, prints stdin lines containing text"
  (lambda (sh args)
    (for-each (lambda (l) (when (string-contains? l (car args)) (print-to (shell-outs sh) l)))
              (or (stdin-lines sh) '()))))

(define-command "tcat" "<file>   : test command, prints a file"
  (lambda (sh args) (print-to (shell-outs sh) (utf8->string (read-file-bytes (shell-path sh (car args)))))))

(define-command "tcount" "   : test command, prints the number of stdin lines"
  (lambda (sh args) (println (shell-outs sh) (length (or (stdin-lines sh) '())))))

(define (contains? s sub) (string-contains? s sub))
(define (matches? s re) (and (regex-search s re) #t))
(define (split-cmd line sh) (call-with-values (lambda () (split-command line sh #f)) list))
(define (scm-runner sh) (call-with-values (lambda () (resolve-scm-runner sh)) list))
(define python (or (find-in-path "python") (find-in-path "python3")))
(define (failed? thunk) (guard (e ((command-failed? e) #t)) (thunk) #f))

(test-runner-factory scm-test-runner)
(test-begin "core")

(test-group "quoting"
  (test-equal "hello" (quote-arg "hello"))
  (test-equal "'hello world'" (quote-arg "hello world"))
  (test-equal "'say \"hi\"'" (quote-arg "say \"hi\""))
  (test-equal "\"it's mine\"" (quote-arg "it's mine"))
  (test-equal "''" (quote-arg ""))
  (test-equal "a 'b c' ''" (quote-args '("a" "b c" "")))
  (let ((sh (make-root-shell)))
    (test-equal '("ls" ("-la" "foo")) (split-cmd "ls -la foo" sh))
    (test-equal '("echo" ("hello world")) (split-cmd "echo \"hello world\"" sh))
    (test-equal '("say \"hi\"") (cadr (split-cmd "echo \"say \\\"hi\\\"\"" sh)))
    (test-equal '("" ()) (split-cmd "" sh)))
  (test-equal 3 (length (split-pipe "a | b | c")))
  (test-equal 1 (length (split-pipe "echo \"a | b\"")))
  (test-equal 1 (length (split-pipe "a || b")))
  (let ((stages (parse-pipeline "echo hi > out.txt")))
    (test-equal 1 (length stages))
    (test-equal "out.txt" (stage-stdout-file (car stages)))
    (test-assert (not (stage-stdout-append (car stages)))))
  (test-assert (stage-stdout-append (car (parse-pipeline "echo hi >> out.txt"))))
  (test-equal "err.txt" (stage-stderr-file (car (parse-pipeline "cmd 2> err.txt"))))
  (test-equal "both.txt" (stage-both-file (car (parse-pipeline "cmd &> both.txt")))))

(test-group "variables"
  (with-shell (lambda (t)
    (run-cmd t "set greeting hello")
    (test-equal "hello" (out t "get greeting"))))
  (with-shell (lambda (t)
    (run-cmd t "set msg hello world")
    (test-equal "hello world" (out t "get msg"))))
  (with-shell (lambda (t)
    (run-cmd t "set name Alice")
    (test-equal "Alice" (out t "print {name}"))))
  (with-shell (lambda (t)
    (run-cmd t "set x 42")
    (let ((o (out t "print '{x}'")))
      (test-assert (contains? o "{x}"))
      (test-assert (not (contains? o "42"))))))
  (with-shell (lambda (t)
    (run-cmd t "set val {!print hello}")
    (test-equal "hello" (out t "get val"))))
  (with-shell (lambda (t)
    (run-cmd t "set result exec print computed")
    (test-equal "computed" (out t "get result"))))
  (with-shell (lambda (t)
    (run-cmd t "set n eval 3 + 4")
    (test-equal "7" (out t "get n"))))
  (with-shell (lambda (t)
    ;; OS environment variables are available with the env: prefix
    (test-assert (contains? (out t (if is-win? "print {env:USERPROFILE}" "print {env:HOME}"))
                            (if is-win? "\\" "/")))))
  (with-shell (lambda (t)
    (run-cmd t "set myvar testval")
    (test-assert (contains? (out t "get") "myvar=testval"))))
  (with-shell (lambda (t)
    (run-cmd t "set base foo")
    (run-cmd t "set full {base}bar")
    (test-equal "foobar" (out t "get full"))))
  (with-shell (lambda (t)
    ;; intentional difference: Python printed None
    (test-equal "\n" (out-raw t "get no_such_variable")))))

(test-group "eval"
  (with-shell (lambda (t)
    (define sh (tc-shell t))
    (define (ev expr) (out t (string-append "eval " expr)))
    (define (ev-set expr) (run-cmd t (string-append "set _r eval " expr)) (out t "get _r"))
    (define (ee expr) (evaluate-expression expr sh))
    (define (truthy expr) (value-truthy? (ee expr)))
    ;; arithmetic
    (test-equal "7" (ev "3 + 4"))
    (test-equal "7" (ev "10 - 3"))
    (test-equal "12" (ev "3 * 4"))
    (test-equal "3" (ev "10 / 3"))
    (test-equal "1" (ev "10 % 3"))
    (test-equal "256" (ev "2 ** 8"))
    ;; numeric comparison
    (test-equal "True" (ev-set "3 < 5"))
    (test-equal "False" (ev-set "5 < 3"))
    (test-equal "True" (ev-set "3 <= 3"))
    (test-equal "True" (ev-set "3 >= 3"))
    (test-assert (ee "5 > 3"))
    (test-equal "True" (ev "3 lt 5"))
    (test-equal "False" (ev "5 lt 3"))
    (test-equal "True" (ev "5 gt 3"))
    (test-equal "True" (ev "3 lteq 3"))
    (test-equal "True" (ev "3 gteq 3"))
    (test-equal "True" (ev "5 gteq 3"))
    (test-equal "False" (ev "2 gteq 3"))
    ;; string comparison
    (test-equal "True" (ev "foo == foo"))
    (test-equal "True" (ev "foo != bar"))
    (test-assert (ee "Foo ==ci foo"))
    (test-assert (ee "Foo !=ci bar"))
    (test-equal "True" (ev "foobar =* foo"))
    (test-equal "True" (ev "foobar *= bar"))
    (test-assert (ee "Foobar =*ci foo"))
    (test-assert (ee "fooBAR *=ci bar"))
    (test-equal "True" (ev "Foo ==ci foo"))
    (test-equal "True" (ev "Foo !=ci bar"))
    (test-equal "True" (ev "Foobar =*ci foo"))
    (test-equal "True" (ev "fooBAR *=ci bar"))
    (test-assert (ee "Foo ==|ci foo"))
    (test-assert (ee "fooBAR *=|ci bar"))
    ;; predicates
    (test-equal "yes" (ev "is-empty \"\""))
    (test-equal "" (ev "is-empty hi"))
    (test-equal "yes" (ev "is-not-empty hi"))
    (test-equal "yes" (ev "not-is-empty hi"))
    (write-file t "exists_test.txt" "x")
    (test-equal "yes" (ev "exists exists_test.txt"))
    (test-equal "" (ev "exists no_such_file.txt"))
    (test-equal "yes" (ev "not-exists no_such_file.txt"))
    (write-file t "f.txt" "x")
    (test-equal "yes" (ev "is-file f.txt"))
    (test-equal "" (ev (string-append "is-file " (tc-dir t))))
    (test-equal "yes" (ev (string-append "is-dir " (tc-dir t))))
    ;; intentional difference: Python compared the extension with the
    ;; whole value (always false)
    (test-equal "yes" (ev "has-extension foo.txt"))
    (test-equal "" (ev "has-extension foo"))
    (test-equal "" (ev "has-not-extension foo.txt"))
    (test-equal "yes" (ev "has-not-extension foo"))
    (test-equal "42" (ev "42"))
    (test-equal "hello" (ev "hello"))
    (test-error (ee "a @@ b"))
    ;; not / and / or
    (test-equal "yes" (ev "not is-empty hello"))
    (test-assert (not (truthy "not is-not-empty hello")))
    (test-assert (truthy "not not is-not-empty hello"))
    (run-cmd t "set x 5")
    (test-equal "yes" (ev "not is-empty {x}"))
    (test-assert (truthy "is-not-empty foo and is-not-empty bar"))
    (test-assert (not (truthy "is-empty foo and is-not-empty bar")))
    (test-assert (not (truthy "is-not-empty foo and is-empty bar")))
    (test-assert (not (truthy "is-empty foo and is-empty bar")))
    (test-assert (not (truthy "3 gt 5 and 2 gt 1")))
    (test-equal "yes" (ev "is-not-empty f.txt and exists f.txt"))
    (test-assert (truthy "is-not-empty foo or is-not-empty bar"))
    (test-assert (truthy "is-not-empty foo or is-empty bar"))
    (test-assert (truthy "is-empty foo or is-not-empty bar"))
    (test-assert (not (truthy "is-empty foo or is-empty bar")))
    (test-equal "yes" (ee "is-not-empty foo or is-empty bar"))
    (test-equal "True" (ev "3 gt 5 or 1 lt 2"))
    ;; precedence and parentheses
    (test-assert (truthy "is-empty foo and is-empty bar or is-not-empty baz"))
    (test-assert (not (truthy "is-empty foo and ( is-empty bar or is-not-empty baz )")))
    (test-assert (truthy "( is-not-empty hello )"))
    (test-assert (truthy "( is-empty foo or is-not-empty bar ) and is-not-empty baz"))
    (test-assert (truthy "( ( is-not-empty a ) and ( is-not-empty b ) )"))
    (test-assert (truthy "not ( is-empty foo and is-empty bar )"))
    (run-cmd t "set n 7")
    (test-equal "True" (ev "( {n} gt 5 ) and ( {n} lt 10 )"))
    (test-error (ee "( is-not-empty foo"))
    ;; combined
    (run-cmd t "set score 75")
    (test-equal "True" (ev "{score} gteq 0 and {score} lteq 100"))
    (write-file t "a.txt" "x")
    (let ((path (write-file t "check.dsh" "if exists a.txt and not exists b.txt\n    print ok\nend\n")))
      (test-assert (contains? (out t (string-append "source " path)) "ok")))
    (test-assert (truthy "3 gt 5 or 4 gt 5 or 5 gt 4"))
    (test-assert (not (truthy "not ( is-not-empty foo and is-not-empty bar )")))
    ;; Python's int() accepts underscores between digits
    (test-equal "True" (ev "1_000 lt 2000"))
    (test-error (ee "1__0 lt 2000"))
    ;; Python bug fixed: more than three operands returned the first one
    ;; ("eval 1 + 2 * 3" printed 1)
    (test-error (ee "1 + 2 * 3")))))

(test-group "echo-print"
  (with-shell (lambda (t)
    (test-equal "hello" (out t "echo hello"))
    (test-assert (contains? (out t "echo \"hello world\"") "hello world"))
    (test-equal "hello" (out t "print hello"))
    (test-equal "hello world" (out t "print hello world"))
    (test-equal "a b c" (out t "print a b c")))))

(test-group "cd-pwd"
  (with-shell (lambda (t)
    (test-equal (tc-dir t) (out t "pwd"))))
  (with-shell (lambda (t)
    (make-dirs (file-path t "sub"))
    (run-cmd t "cd sub")
    (test-equal (file-path t "sub") (shell-cwd (tc-shell t)))))
  (with-shell (lambda (t)
    (make-dirs (file-path t "abs"))
    (run-cmd t (string-append "cd " (file-path t "abs")))
    (test-equal (file-path t "abs") (shell-cwd (tc-shell t)))))
  (with-shell (lambda (t)
    (make-dirs (file-path t "child"))
    (run-cmd t "cd child")
    (run-cmd t "cd ..")
    (test-equal (tc-dir t) (shell-cwd (tc-shell t)))))
  (with-shell (lambda (t)
    (test-assert (contains? (err t "cd no_such_dir") "ERR"))))
  (with-shell (lambda (t)
    (shell-cwd-set! (tc-shell t) (file-path t "x"))
    (run-cmd t "cd")
    (test-equal (path-normpath (home-directory)) (shell-cwd (tc-shell t))))))

(test-group "alias"
  (with-shell (lambda (t)
    (run-cmd t "alias hi print hello")
    (test-equal "hello" (out t "hi"))))
  (with-shell (lambda (t)
    (run-cmd t "alias greet print hi")
    (test-equal "hi there" (out t "greet there"))))
  (with-shell (lambda (t)
    (run-cmd t "alias myls ls -la")
    (test-assert (contains? (out t "alias") "myls"))
    (test-assert (contains? (out t "alias myls") "ls"))
    (run-cmd t "alias myls -")
    (test-assert (not (contains? (out t "alias") "myls")))))
  (with-shell (lambda (t)
    ;; Python used ls; cd is a builtin of the core
    (test-assert (contains? (err t "alias cd something_else") "ERR")))))

(test-group "options"
  (with-shell (lambda (t)
    (test-assert (member (out t "option echo") '("on" "off")))
    (run-cmd t "option echo on")
    (test-assert (shell-option-on? (tc-shell t) "echo"))
    (test-assert (contains? (out t "print hello") "::"))
    (run-cmd t "option echo off")
    (test-assert (not (shell-option-on? (tc-shell t) "echo")))
    (let ((o (out t "options")))
      (test-assert (contains? o "echo"))
      (test-assert (contains? o "stop-on-error")))))
  (with-shell (lambda (t)
    ;; Python used rm of a missing file to fail
    (run-cmd t "option stop-on-error off")
    (test-equal "reached" (out t "totally_nonexistent_binary_xyz && print reached"))))
  (with-shell (lambda (t)
    ;; Python crashed with IndexError
    (test-equal "ERR: option requires a name" (err t "option")))))

(test-group "pipes"
  ;; Python piped cat/grep/wc; here the test commands tcat, tgrep, tcount
  (with-shell (lambda (t)
    (write-file t "data.txt" "apple
banana
apricot
cherry
")
    (test-equal "apple
apricot" (out t "tcat data.txt | tgrep ap"))
    (test-equal "4" (out t "tcat data.txt | tcount"))
    (test-equal "3" (out t "tcat data.txt | tgrep a | tcount"))
    (test-equal "1" (out t "echo hello | tcount"))
    (test-equal "0" (out t "print banana | tgrep x | tcount"))))
  (with-shell (lambda (t)
    ;; an error in an earlier stage restores the shell's output
    (define sh (tc-shell t))
    (let ((o (shell-outs sh)))
      (test-error (shell-execute sh "eval 1 / 0 | tcount" #f))
      (test-assert (eq? o (shell-outs sh)))))))

(test-group "redirects"
  (with-shell (lambda (t)
    (run-cmd t "print hello > out.txt")
    (test-equal "hello\n" (string-replace* (read-text t "out.txt") "\r\n" "\n"))))
  (with-shell (lambda (t)
    (write-file t "out.txt" "old content\n")
    (run-cmd t "print new > out.txt")
    (test-equal "new\n" (string-replace* (read-text t "out.txt") "\r\n" "\n"))))
  (with-shell (lambda (t)
    (run-cmd t "print first > out.txt")
    (run-cmd t "print second >> out.txt")
    (test-equal "first\nsecond\n" (read-text t "out.txt"))))
  (with-shell (lambda (t)
    ;; Python used rmdir of a file
    (run-cmd t "cd no_such_dir 2> err.txt")
    (test-assert (contains? (read-text t "err.txt") "ERR"))))
  (with-shell (lambda (t)
    (run-cmd t "print out &> both.txt")
    (test-assert (contains? (read-text t "both.txt") "out"))
    (run-cmd t "cd no_such_dir &>> both.txt")
    (test-assert (contains? (read-text t "both.txt") "ERR"))))
  (with-shell (lambda (t)
    (run-cmd t "print hello | tgrep hello > match.txt")
    (test-equal "hello\n" (read-text t "match.txt")))))

(test-group "and-and"
  (with-shell (lambda (t)
    (let ((o (out t "print first && print second")))
      (test-assert (contains? o "first"))
      (test-assert (contains? o "second")))))
  (with-shell (lambda (t)
    (shell-option-set! (tc-shell t) "stop-on-error" "on")
    (test-assert (failed? (lambda () (shell-execute (tc-shell t)
                                                    "totally_nonexistent_binary_xyz && print x > marker.txt"
                                                    #f))))
    (test-assert (not (file? (file-path t "marker.txt"))))))
  (with-shell (lambda (t)
    (test-equal "done" (out t "print x > marker.txt && print done"))
    (test-assert (file? (file-path t "marker.txt")))))
  (with-shell (lambda (t)
    (test-assert (contains? (out t "print \"a && b\"") "&&")))))

(test-group "which-help"
  (with-shell (lambda (t)
    ;; Python used ls and grep (other libraries); cd and eval are core
    (test-assert (contains? (out t "which cd") "internal"))
    (test-equal "" (out t "which totally_unknown_cmd_xyz"))
    (let ((o (out t "help")))
      (for-each (lambda (c) (test-assert c (contains? o c))) '("cd" "eval" "set" "get" "alias")))
    (let ((o (out t "help eval")))
      (test-assert (contains? o "eval"))
      (test-assert (contains? o "expression"))))))

(test-group "history"
  (with-shell (lambda (t)
    (shell-execute (tc-shell t) "print alpha" #t)
    (shell-execute (tc-shell t) "print beta" #t)
    (let ((o (out t "history")))
      (test-assert (contains? o "print alpha"))
      (test-assert (contains? o "print beta")))
    (let ((o (out t "history alpha")))
      (test-assert (contains? o "alpha"))
      (test-assert (not (contains? o "beta"))))))
  (with-shell (lambda (t)
    (define sh (tc-shell t))
    (shell-execute sh "print here" #t)
    (make-dirs (file-path t "other"))
    (shell-cwd-set! sh (file-path t "other"))
    (shell-execute sh "print there" #t)
    (shell-cwd-set! sh (tc-dir t))
    (let ((o (out t "lhistory")))
      (test-assert (contains? o "print here"))
      (test-assert (not (contains? o "print there")))))))

(test-group "time"
  (with-shell (lambda (t)
    (let-values (((o e) (run-cmd t "time print hello")))
      (test-assert (contains? o "hello"))
      (test-assert (matches? (string-strip e) "^real\\s+[\\d.]+s$")))
    (test-assert (contains? (err t "time") "ERR"))))
  (with-shell (lambda (t)
    (define sh (tc-shell t))
    (let ((before (session-history (shell-session sh))))
      (shell-execute sh "time print hello" #t)
      (let ((added (filter (lambda (h) (not (member h before))) (session-history (shell-session sh)))))
        (test-assert (not (member "print hello" added)))
        (test-equal '("time print hello") added)))))
  (with-shell (lambda (t)
    ;; Python bug fixed: {!cmd} added cmd to the history
    (define sh (tc-shell t))
    (shell-execute sh "print {!print inner}" #t)
    (test-equal '("print {!print inner}") (session-history (shell-session sh))))))

(test-group "env"
  (let ((e (make-env)))
    (env-set! e "x" 1)
    (test-equal 1 (env-get e "x"))
    (test-equal #f (env-get e "missing"))
    (test-equal "default" (env-get e "missing" "default"))
    (env-remove! e "x")
    (test-equal #f (env-get e "x")))
  (let* ((parent (make-env)) (child (make-env parent)))
    (env-set! parent "a" "from_parent")
    (test-equal "from_parent" (env-get child "a"))
    (env-set! parent "x" "parent_val")
    (env-set! child "x" "child_val")
    (test-equal "child_val" (env-get child "x"))
    (test-equal "parent_val" (env-get parent "x"))
    (env-set! parent "z" "old")
    (env-update! child "z" "new")
    (test-equal "new" (env-get parent "z"))
    (test-assert (not (env-has-local? child "z")))
    (env-set! child "b" 2)
    (test-assert (member "a" (env-names child)))
    (test-assert (member "b" (env-names child)))))

(test-group "env-overlay"
  (let ((st (parse-redirects "FOO=bar mycmd arg")))
    (test-equal '(("FOO" . "bar")) (stage-env-overlay st))
    (test-equal "mycmd arg" (stage-raw st)))
  (let ((st (parse-redirects "A=1 B=two mycmd")))
    (test-equal '(("A" . "1") ("B" . "two")) (stage-env-overlay st))
    (test-equal "mycmd" (stage-raw st)))
  (let ((st (parse-redirects "mycmd FOO=bar")))
    (test-equal #f (stage-env-overlay st))
    (test-equal "mycmd FOO=bar" (stage-raw st)))
  (let ((st (parse-redirects "FOO= mycmd")))
    (test-equal '(("FOO" . "")) (stage-env-overlay st))
    (test-equal "mycmd" (stage-raw st)))
  (test-equal #f (stage-env-overlay (parse-redirects "mycmd a b c")))
  (let ((sh (make-root-shell)))
    (shell-env-set! sh (make-env))
    (env-set! (shell-env sh) "env:KEEP" "kept")
    (env-set! (shell-env sh) "env:OVER" "original")
    (let ((merged (child-env sh '(("OVER" . "overridden") ("NEW" . "added")))))
      (test-equal '("kept") (cdr (assoc "KEEP" merged)))
      (test-equal '("overridden") (cdr (assoc "OVER" merged)))
      (test-equal '("added") (cdr (assoc "NEW" merged)))
      (test-equal 3 (length merged))))
  (when python
    (with-shell (lambda (t)
      (let ((py (quote-arg python)))
        (test-assert (contains? (out t (string-append
                                        "DABSHELL_TEST_VAR=hello " py " -c "
                                        "\"import os; print(os.environ.get('DABSHELL_TEST_VAR', 'MISSING'))\""))
                                "hello"))
        (run-cmd t (string-append "DABSHELL_TEST_NOPERSIST=x " py " -c \"import sys; sys.exit(0)\""))
        (test-assert (contains? (out t (string-append
                                        py " -c "
                                        "\"import os; print(os.environ.get('DABSHELL_TEST_NOPERSIST', 'MISSING'))\""))
                                "MISSING"))
        (test-equal #f (env-get (shell-env (tc-shell t)) "env:DABSHELL_TEST_NOPERSIST")))))))

(test-group "external-redirects"
  (when python
    (with-shell (lambda (t)
      (let* ((py (quote-arg python))
             ;; stdin is read only when piped: else the program has the shell's
             (prog (string-append py " -c \"import sys; print('o'); print('e', file=sys.stderr)\""))
             (upper (string-append py " -c \"import sys; print(sys.stdin.read().strip().upper());"
                                   " print('e', file=sys.stderr)\""))
             (lines (lambda (name) (splitlines (read-text t name)))))
        ;; the program writes to the files itself
        (run-cmd t (string-append prog " > o.txt 2> e.txt"))
        (test-equal '("o") (lines "o.txt"))
        (test-equal '("e") (lines "e.txt"))
        (run-cmd t (string-append prog " >> o.txt 2>> e.txt"))
        (test-equal '("o" "o") (lines "o.txt"))
        (test-equal '("e" "e") (lines "e.txt"))
        (run-cmd t (string-append prog " > o.txt"))
        (test-equal '("o") (lines "o.txt"))
        ;; piped input with the output in a file
        (run-cmd t (string-append "print abc | " upper " > o.txt 2> e.txt"))
        (test-equal '("ABC") (lines "o.txt"))
        ;; stdout and stderr in one file
        (run-cmd t (string-append prog " &> both.txt"))
        (test-equal '("e" "o") (sort-strings (lines "both.txt")))
        ;; a background job with separate files
        (write-file t "be.txt" "old\n")
        (run-cmd t (string-append prog " > bo.txt 2> be.txt &"))
        (run-cmd t "wait")
        (test-equal '("o") (lines "bo.txt"))
        (test-equal '("e") (lines "be.txt"))
        ;; appending, and one file for both
        (write-file t "bo.txt" "old\n")
        (run-cmd t (string-append prog " >> bo.txt 2> be.txt &"))
        (run-cmd t "wait")
        (test-equal '("old" "o") (lines "bo.txt"))
        (run-cmd t (string-append prog " &> bb.txt &"))
        (run-cmd t "wait")
        (test-equal '("e" "o") (sort-strings (lines "bb.txt")))
        (run-cmd t (string-append prog " &>> bb.txt"))
        (test-equal '("e" "e" "o" "o") (sort-strings (lines "bb.txt"))))))))

(test-group "bug-fixes"
  (when python
    (with-shell (lambda (t)
      (let-values (((o e) (run-cmd t (string-append (quote-arg python) " --version"))))
        (test-assert (contains? o "Python"))
        (test-equal "" e)))))
  (with-shell (lambda (t)
    ;; the script command with arguments, as the entry point runs it
    (let ((sh (make-root-shell))
          (o (open-output-string))
          (path (write-file t "entry.dsh" "print {arg0} {arg1} {argc}\n")))
      (shell-cwd-set! sh (tc-dir t))
      (shell-outs-set! sh o)
      ((cmd-run (env-get (shell-env sh) "script")) sh (list path "foo" "bar"))
      (test-equal "foo bar 2\n" (get-output-string o)))))
  (with-shell (lambda (t)
    (shell-option-set! (tc-shell t) "stop-on-error" "on")
    (test-assert (failed? (lambda () (shell-execute (tc-shell t) "totally_nonexistent_cmd_xyz" #f)))))))

(test-group "scm-runner"
  (with-shell (lambda (t)
    (write-file t "scm.scm" "")
    (write-file t "foo.scm" "")
    (test-assert (contains? (err t "foo.scm") "is itself a .scm script"))))
  (with-shell (lambda (t)
    (define sh (tc-shell t))
    (test-equal '("scm" ()) (scm-runner sh))
    (run-cmd t "alias scm guile -s")
    (test-equal '("guile" ("-s")) (scm-runner sh))))
  (with-shell (lambda (t)
    (define sh (tc-shell t))
    (run-cmd t "alias scm scmc")
    (test-equal "scmc" (out t "setscm"))
    (run-cmd t "setscm scmj")
    (test-equal '("scmj" ()) (scm-runner sh))
    (test-equal "scmj" (out t "setscm"))
    (run-cmd t "setscm guile -s")
    (test-equal '("guile" ("-s")) (scm-runner sh))
    (run-cmd t "setscm -")
    (test-equal '("scmc" ()) (scm-runner sh))))
  (with-shell (lambda (t)
    ;; intentional difference: the setscm state is shared with nested shells
    (run-cmd t "setscm scmj")
    (test-equal "scmj" (out t "print {!setscm}")))))

(test-end "core")
(exit (if (zero? (last-run-failed-tests)) 0 1))
