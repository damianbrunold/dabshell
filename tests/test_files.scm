;; ── TestTree ────────────────────────────────────────────────────────────

(define (with-tree proc)
  (with-shell (lambda (t)
    (mkdir t "src/sub")
    (write-file t "src/a.py" "")
    (write-file t "src/b.py" "")
    (write-file t "src/sub/c.py" "")
    (write-file t "README.md" "")
    (proc t))))

(test-group "tree"
  (with-tree (lambda (t)
    (let ((o (out t "tree")))
      (test-assert "test_tree_lists_all a" (contains? o "a.py"))
      (test-assert "test_tree_lists_all c" (contains? o "c.py"))
      (test-assert "test_tree_lists_all readme" (contains? o "README.md")))))
  (with-tree (lambda (t)
    (let ((o (out t "tree . *.py")))
      (test-assert "test_tree_filter_py a" (contains? o "a.py"))
      (test-assert "test_tree_filter_py c" (contains? o "c.py"))
      (test-assert "test_tree_filter_py readme" (not (contains? o "README"))))))
  (with-tree (lambda (t)
    (let ((o (out t "tree . README.md")))
      (test-assert "test_tree_filter_exact readme" (contains? o "README.md"))
      (test-assert "test_tree_filter_exact a" (not (contains? o "a.py"))))))
  (with-tree (lambda (t)
    (mkdir t "__pycache__")
    (write-file t "__pycache__/x.pyc" (bytes 0))
    (test-assert "test_tree_skips_pycache" (not (contains? (out t "tree") "__pycache__")))))
  (with-tree (lambda (t)
    (test-equal "tree without directory argument filters"
                (list (file-path t (native-path "src" "a.py")) (file-path t (native-path "src" "b.py"))
                      (file-path t (native-path "src" "sub" "c.py")))
                (lines (out t "tree *.py")))
    (test-equal "tree prefix filter" (list (file-path t "README.md")) (lines (out t "tree READ*"))))))

;; ── TestConvertCommands ─────────────────────────────────────────────────

;; write content, run the conversion: (list new-bytes out err)
(define (run-conv t cmd raw)
  (let ((path (write-file t "conv_test.txt" raw)))
    (let-values (((o e) (run-cmd t (string-append cmd " " path))))
      (list (read-file t "conv_test.txt") o e))))

(define (conv cmd raw) (let ((r #f)) (with-shell (lambda (t) (set! r (run-conv t cmd raw)))) r))

(test-group "convert"
  (test-equal "test_detect_utf8_bom" 'utf-8-sig (detect-file-encoding (bytevector-append (bytes #xef #xbb #xbf) (string->utf8 "hello"))))
  (test-equal "test_detect_utf8" 'utf-8 (detect-file-encoding (string->utf8 "caf\xe9;")))
  (test-equal "test_detect_latin1" 'latin-1 (detect-file-encoding (bytes #xe9)))
  (test-equal "test_detect_utf16" 'utf-16 (detect-file-encoding (bytevector-append (bytes #xff #xfe) (string->utf8 "hello"))))
  (test-assert "test_is_binary_true" (binary-bytes? (bytes-range 256)))
  (test-assert "test_is_binary_false_text" (not (binary-bytes? (string->utf8 "hello world\n"))))
  (test-assert "test_is_binary_empty" (not (binary-bytes? (bytevector))))

  (test-equal "test_to_lf_converts_crlf" (string->utf8 "a\nb\n") (car (conv "to-lf" (string->utf8 "a\r\nb\r\n"))))
  (test-equal "test_to_lf_converts_bare_cr" (string->utf8 "a\nb\n") (car (conv "to-lf" (string->utf8 "a\rb\r"))))
  (test-assert "test_to_lf_unchanged_if_already_lf" (contains? (cadr (conv "to-lf" (string->utf8 "a\nb\n"))) "unchanged"))
  (let ((r (car (conv "to-lf" (bytevector-append (bytes #xef #xbb #xbf) (string->utf8 "a\r\nb\r\n"))))))
    (test-assert "test_to_lf_preserves_utf8_bom bom" (bv-starts? r (bytes #xef #xbb #xbf)))
    (test-assert "test_to_lf_preserves_utf8_bom lf" (bv-member? r 10))
    (test-assert "test_to_lf_preserves_utf8_bom no cr" (not (bv-member? r 13))))
  (test-assert "test_to_lf_skips_binary" (contains? (caddr (conv "to-lf" (bytes-range 256))) "skipped"))

  (test-equal "test_to_crlf_converts_lf" (string->utf8 "a\r\nb\r\n") (car (conv "to-crlf" (string->utf8 "a\nb\n"))))
  (test-assert "test_to_crlf_unchanged_if_already_crlf" (contains? (cadr (conv "to-crlf" (string->utf8 "a\r\nb\r\n"))) "unchanged"))
  (test-equal "test_to_crlf_normalises_mixed" (string->utf8 "a\r\nb\r\n") (car (conv "to-crlf" (string->utf8 "a\r\nb\n"))))
  (test-equal "test_to_crlf_preserves_latin1" (latin1 "caf\xe9;\r\n") (car (conv "to-crlf" (latin1 "caf\xe9;\n"))))

  (test-equal "test_to_utf8_converts_latin1" (string->utf8 "caf\xe9;\n") (car (conv "to-utf8" (latin1 "caf\xe9;\n"))))
  (test-equal "test_to_utf8_strips_bom" (string->utf8 "hello\n")
              (car (conv "to-utf8" (bytevector-append (bytes #xef #xbb #xbf) (string->utf8 "hello\n")))))
  (test-assert "test_to_utf8_unchanged_if_already_utf8" (contains? (cadr (conv "to-utf8" (string->utf8 "hello\n"))) "unchanged"))

  (test-assert "test_to_utf8_bom_adds_bom" (bv-starts? (car (conv "to-utf8-bom" (string->utf8 "hello\n"))) (bytes #xef #xbb #xbf)))
  (test-assert "test_to_utf8_bom_unchanged_if_already_bom"
               (contains? (cadr (conv "to-utf8-bom" (bytevector-append (bytes #xef #xbb #xbf) (string->utf8 "hello\n")))) "unchanged"))
  (let ((r (car (conv "to-utf8-bom" (latin1 "caf\xe9;\n")))))
    (test-assert "test_to_utf8_bom_converts_latin1 bom" (bv-starts? r (bytes #xef #xbb #xbf)))
    (test-assert "test_to_utf8_bom_converts_latin1 text" (bv-contains? r (string->utf8 "caf\xe9;"))))

  (test-equal "test_to_latin1_converts_utf8" (latin1 "caf\xe9;\n") (car (conv "to-latin1" (string->utf8 "caf\xe9;\n"))))
  (test-assert "test_to_latin1_unchanged_if_already_latin1" (contains? (cadr (conv "to-latin1" (latin1 "caf\xe9;\n"))) "unchanged"))
  (let* ((raw (string->utf8 "\x4e2d;\x6587;\n"))
         (r (conv "to-latin1" raw)))
    (test-assert "test_to_latin1_skips_unencodable" (contains? (cadr r) "skipped"))
    (test-assert "to-latin1 message" (contains? (cadr r) "can't encode characters in position 0-1"))
    (test-equal "test_to_latin1_skips_unencodable unchanged" raw (car r)))
  (test-assert "to-utf8 skips utf-16"
               (contains? (cadr (conv "to-utf8" (bytevector-append (bytes #xff #xfe) (string->utf8 "h")))) "UTF-16 not supported"))

  (with-shell (lambda (t)
    (write-file t "g1.txt" (string->utf8 "a\r\nb\r\n"))
    (write-file t "g2.txt" (string->utf8 "c\r\nd\r\n"))
    (run-cmd t (string-append "to-lf " (file-path t "*.txt")))
    (test-equal "test_glob_converts_multiple_files 1" (string->utf8 "a\nb\n") (read-file t "g1.txt"))
    (test-equal "test_glob_converts_multiple_files 2" (string->utf8 "c\nd\n") (read-file t "g2.txt"))))
  (with-shell (lambda (t)
    (for-each (lambda (cmd) (test-assert (string-append "test_no_args_gives_error " cmd) (contains? (err t cmd) "ERR")))
              '("to-lf" "to-crlf" "to-utf8" "to-utf8-bom" "to-latin1"))
    (test-assert "convert missing file" (contains? (err t "to-lf nope.txt") "not found"))
    (mkdir t "d")
    (test-assert "convert directory" (contains? (err t "to-lf d") "is a directory")))))

;; ── TestGlob (the file commands) ────────────────────────────────────────

(define (with-glob proc)
  (with-shell (lambda (t)
    (write-file t "alpha.txt" "aaa\n")
    (write-file t "beta.txt" "bbb\n")
    (write-file t "gamma.txt" "ccc\n")
    (proc t))))

(test-group "glob"
  (with-glob (lambda (t)
    (with-process-cwd-elsewhere t (lambda ()
      (let ((o (out t "ls *.txt")))
        (test-assert "test_ls_glob_uses_shell_cwd alpha" (contains? o "alpha.txt"))
        (test-assert "test_ls_glob_uses_shell_cwd gamma" (contains? o "gamma.txt"))
        (test-equal "test_ls_glob_sorted" '("alpha.txt" "beta.txt" "gamma.txt") (lines o)))))))
  (with-glob (lambda (t)
    (with-process-cwd-elsewhere t (lambda ()
      (run-cmd t "rm *.txt")
      (test-equal "test_rm_glob_uses_shell_cwd" '()
                  (filter-names (directory-files (tc-dir t)) ".txt"))))))
  (with-glob (lambda (t)
    (mkdir t "dest")
    (with-process-cwd-elsewhere t (lambda ()
      (run-cmd t "cp *.txt dest")
      (test-assert "test_cp_glob_uses_shell_cwd alpha" (is-file? t (native-path "dest" "alpha.txt")))
      (test-assert "test_cp_glob_uses_shell_cwd gamma" (is-file? t (native-path "dest" "gamma.txt")))))))
  (with-glob (lambda (t)
    (for-each (lambda (n) (set-file-modification-time! (file-path t n) 1000000000000))
              '("alpha.txt" "beta.txt" "gamma.txt"))
    (with-process-cwd-elsewhere t (lambda ()
      (run-cmd t "touch *.txt")
      (for-each (lambda (n) (test-assert (string-append "test_touch_glob_uses_shell_cwd " n)
                                         (> (mtime t n) 1000000000000)))
                '("alpha.txt" "beta.txt" "gamma.txt")))))))

;; ── TestFileCmd ─────────────────────────────────────────────────────────

(test-group "file"
  (with-shell (lambda (t)
    (write-file t "hello.py" "print('hi')\n")
    (test-assert "test_detects_python_source" (contains? (out t "file hello.py") "Python source"))
    (test-equal "file python full" "hello.py: Python source, ASCII, LF line endings" (out t "file hello.py"))
    (write-file t "data.json" "{\"key\": \"value\"}\n")
    (test-assert "test_detects_json" (contains? (out t "file data.json") "JSON"))
    (mkdir t "mydir")
    (test-assert "test_detects_directory" (contains? (out t "file mydir") "directory"))
    (write-file t "empty.txt" (bytevector))
    (test-assert "test_detects_empty_file" (contains? (out t "file empty.txt") "empty"))
    (write-file t "img.png" (bytevector-append (bytes #x89) (string->utf8 "PNG\r\n") (bytes #x1a 10) (make-bytevector 16 0)))
    (test-assert "test_detects_png" (contains? (out t "file img.png") "PNG"))
    (test-equal "file png dims" "img.png: PNG image, 0x0" (out t "file img.png"))
    (write-file t "notes.md" "# Title\nBody\n")
    (let ((o (out t "file notes.md")))
      (test-assert "test_detects_markdown_encoding_and_endings md" (contains? o "Markdown"))
      (test-assert "test_detects_markdown_encoding_and_endings ascii" (contains? o "ASCII")))
    (test-assert "test_missing_file" (contains? (out t "file missing.txt") "ERROR"))
    (test-assert "test_no_args_gives_error" (contains? (err t "file") "ERR"))))
  (with-shell (lambda (t)
    (write-file t "script" "#!/usr/bin/env python3\nprint(1)\n")
    (test-equal "file shebang" "script: Python script, ASCII, LF line endings" (out t "file script"))
    (write-file t "mixed" "a\r\nb\nc\n")
    (test-equal "file mixed endings" "mixed: text, ASCII, mixed line endings (CRLF: 1, LF: 2)" (out t "file mixed"))
    (write-file t "data" (bytevector-append (string->utf8 "GIF89a") (bytes 3 0 2 0)))
    (test-equal "file gif dims" "data: GIF image, 3x2" (out t "file data"))
    (write-file t "bin" (bytes-range 32))
    (test-equal "file binary" "bin: binary data (84% non-printable bytes)" (out t "file bin"))
    (write-file t "latin" (latin1 "caf\xe9;"))
    (test-equal "file latin1" "latin: text, Latin-1, no line endings" (out t "file latin"))
    (write-file t "Dockerfile" "FROM x\n")
    (test-equal "file dockerfile" "Dockerfile: Dockerfile" (out t "file Dockerfile"))
    (write-file t "page" "<!DOCTYPE html>\n<html></html>\n")
    (test-equal "file html" "page: HTML document, ASCII, LF line endings" (out t "file page"))))
  ;; bug fix: PEM content was never recognized (the first line is upper case)
  (with-shell (lambda (t)
    (write-file t "cert" "-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----\n")
    (test-equal "file pem content" "cert: PEM data, ASCII, LF line endings" (out t "file cert"))))
  ;; bug fix: a UTF-8 character cut at the 8 KB header limit is not Latin-1
  (with-shell (lambda (t)
    (write-file t "long.txt" (string-append (make-string 8191 #\a) "\xe9;"))
    (test-equal "file utf-8 cut at header end" "long.txt: plain text, UTF-8, no line endings" (out t "file long.txt"))))
  (with-shell (lambda (t)
    (let ((zip (file-path t "x.zip")))
      (write-file t "w.txt" "x")
      (test-equal "file zip probe" "PK" (utf8->string (bytevector-copy (make-zip zip "a.txt") 0 2)))
      (test-equal "file zip" "x.zip: ZIP archive" (out t "file x.zip"))
      (make-zip zip "word/document.xml")
      (test-equal "file docx" "x.zip: Word document (.docx)" (out t "file x.zip"))))))

;; ── open ────────────────────────────────────────────────────────────────

(test-group "open"
  (with-shell (lambda (t)
    (test-equal "open missing argument" "ERR: open: missing argument" (err t "open"))
    (test-equal "open missing file" "ERR: open: nope.txt not found" (err t "open nope.txt")))))

(test-end "files")
(exit (if (zero? (last-run-failed-tests)) 0 1))
