;; Tests of the file commands: ls, du, find, hash, cp, mv, tree, touch, rm,
;; mkdir, rmdir, basename/dirname/get-ext/remove-ext, file, open and the
;; conversion commands (port of the corresponding classes of
;; tests/test_dabshell.py).

(import (scheme base) (scheme char) (scheme process-context) (scheme time)
        (scm fs) (scm module) (scm test) (scm zip))
(define root (directory-name (directory-name (absolute-path (car (command-line))))))
(module-search-path! (append (list (join-path root "src") (join-path root "tests"))
                             (module-search-path)))
(import (dabshell util) (dabshell core) (dabshell builtins) (dabshell files) (dabshell testing))

(define (contains? s sub) (string-contains? s sub))
(define (lines s) (splitlines s))
(define (bytes . xs) (apply bytevector xs))
(define (latin1 s) (string->utf8* s 'latin1))
(define (string->utf8* s enc)
  (if (eq? enc 'latin1)
      (apply bytevector (map char->integer (string->list s)))
      (string->utf8 s)))
(define (exists? t name) (path-exists?* (file-path t name)))
(define (is-file? t name) (file? (file-path t name)))
(define (is-dir? t name) (directory? (file-path t name)))
(define (mkdir t name) (make-dirs (file-path t name)))
(define (native-path . parts) (string-join* parts (if is-win? "\\" "/")))
(define (bytes-range n) (let ((bv (make-bytevector n))) (do ((i 0 (+ i 1))) ((= i n) bv) (bytevector-u8-set! bv i i))))
(define (bv-starts? bv prefix)
  (and (>= (bytevector-length bv) (bytevector-length prefix))
       (equal? (bytevector-copy bv 0 (bytevector-length prefix)) prefix)))
(define (bv-contains? bv sub)
  (let ((n (bytevector-length bv)) (m (bytevector-length sub)))
    (let loop ((i 0))
      (and (<= (+ i m) n)
           (or (equal? (bytevector-copy bv i (+ i m)) sub) (loop (+ i 1)))))))
(define (bv-member? bv byte)
  (let loop ((i 0)) (and (< i (bytevector-length bv)) (or (= (bytevector-u8-ref bv i) byte) (loop (+ i 1))))))
(define (mtime t name) (file-modification-timestamp (file-path t name)))
;; the label column of du output lines
(define (du-labels o) (map (lambda (l) (string-strip (cadr (string-split-on (string-strip l) " " 1)))) (lines o)))
(define (du-sizes o) (map (lambda (l) (string->number (car (string-split-ws l)))) (lines o)))
(define (sorted-desc? xs) (or (null? xs) (null? (cdr xs)) (and (>= (car xs) (cadr xs)) (sorted-desc? (cdr xs)))))
(define (index-of x lst) (list-index-of (lambda (y) (equal? x y)) lst))

(define (filter-lines s needle)
  (let loop ((ls (lines s)))
    (cond ((null? ls) '())
          ((contains? (car ls) needle) (cons (car ls) (loop (cdr ls))))
          (else (loop (cdr ls))))))

(define (filter-names names suffix)
  (cond ((null? names) '())
        ((string-ends? (car names) suffix) (cons (car names) (filter-names (cdr names) suffix)))
        (else (filter-names (cdr names) suffix))))

;; a ZIP file with one entry, written with (scm zip)
(define (make-zip path entry)
  (call-with-output-zip path (lambda (z) (write-string "x" (zip-add-text-entry z entry))))
  (read-file-bytes path))

;; run thunk with the process cwd moved away from the test directory
(define (with-process-cwd-elsewhere t thunk)
  (let ((saved (current-directory)))
    (dynamic-wind
      (lambda () (cd (path-dirname (tc-dir t))))
      thunk
      (lambda () (cd saved)))))

(test-runner-factory scm-test-runner)
(test-begin "files")

;; ── TestLs ──────────────────────────────────────────────────────────────

(define (with-ls proc)
  (with-shell (lambda (t)
    (write-file t "alpha.txt" "a")
    (write-file t "beta.py" "b")
    (mkdir t "mydir")
    (proc t))))

(test-group "ls"
  (with-ls (lambda (t)
    (let ((o (out t "ls")))
      (test-assert "test_ls_lists_files alpha" (contains? o "alpha.txt"))
      (test-assert "test_ls_lists_files beta" (contains? o "beta.py"))
      (test-assert "test_ls_lists_files mydir" (contains? o "mydir")))))
  (with-ls (lambda (t)
    (let ((ls (filter-lines (out t "ls -l") "alpha.txt")))
      (test-assert "test_ls_long_has_size" (and (pair? ls) (string->number (car (string-split-ws (car ls))))))
      (test-equal "test_ls_long_has_size format" 1 (string->number (car (string-split-ws (car ls))))))))
  (with-ls (lambda (t)
    (let ((o (out t "ls alpha.txt")))
      (test-assert "test_ls_specific_file" (contains? o "alpha.txt"))
      (test-assert "test_ls_specific_file not beta" (not (contains? o "beta.py"))))))
  (with-ls (lambda (t)
    (let ((names (lines (out t "ls -r"))))
      (test-assert "test_ls_sort_reverse 1" (< (index-of "mydir" names) (index-of "beta.py" names)))
      (test-assert "test_ls_sort_reverse 2" (< (index-of "beta.py" names) (index-of "alpha.txt" names))))))
  (with-ls (lambda (t)
    (test-equal "ls sorted by name" '("alpha.txt" "beta.py" "mydir") (lines (out t "ls")))
    (write-file t "big.txt" (make-string 100 #\x))
    (test-equal "ls -S largest first" "big.txt" (car (lines (out t "ls -S"))))
    (test-assert "ls missing" (contains? (err t "ls nope") "not found"))))
  (with-ls (lambda (t)
    (let ((l (car (filter-lines (out-raw t "ls -l alpha.txt") "alpha.txt"))))
      ;; "         1 YYYY-MM-DD HH:MM:SS alpha.txt"
      (test-equal "ls -l layout" 40 (string-length l))
      (test-equal "ls -l date" #\- (string-ref l 15)))
    (set-file-modification-time! (file-path t "alpha.txt") 1000000000000)
    (test-equal "ls -l timestamp in UTC" "         1 2001-09-09 01:46:40 alpha.txt"
                (car (filter-lines (out-raw t "ls -l alpha.txt") "alpha.txt")))
    (set-file-modification-time! (file-path t "beta.py") 1000000000000)
    (test-equal "ls -t newest first" "mydir" (car (lines (out t "ls -t"))))
    (test-equal "ls -tr oldest first, stable" '("alpha.txt" "beta.py") (take-up-to (lines (out t "ls -tr")) 2)))))

;; ── TestDu ──────────────────────────────────────────────────────────────

(define (with-du proc)
  (with-shell (lambda (t)
    (mkdir t "tree/sub1/deep")
    (mkdir t "tree/sub2")
    (write-file t "tree/a.txt" (make-string 100 #\a))
    (write-file t "tree/sub1/big.txt" (make-string 2048 #\x))
    (write-file t "tree/sub1/deep/d.txt" (make-string 16 #\y))
    (write-file t "tree/sub2/b.txt" "bb")
    (proc t))))

(test-group "du"
  (with-du (lambda (t)
    (let ((parts (string-split-ws (car (reverse (lines (out t "du -s -b tree")))))))
      (test-equal "test_du_summary_bytes size" 2166 (string->number (car parts)))
      (test-equal "test_du_summary_bytes label" "tree" (cadr parts)))))
  (with-du (lambda (t)
    (let ((line (car (reverse (lines (out t "du -s tree"))))))
      (test-equal "test_du_default_is_human" "2.12K tree" line))))
  (with-du (lambda (t)
    (let ((labels (du-labels (out t "du -d 1 -b tree"))))
      (test-assert "test_du_max_depth_lists_subdirs tree" (member "tree" labels))
      (test-assert "test_du_max_depth_lists_subdirs sub1" (member (native-path "tree" "sub1") labels))
      (test-assert "test_du_max_depth_lists_subdirs sub2" (member (native-path "tree" "sub2") labels))
      (test-assert "test_du_max_depth_lists_subdirs deep" (not (member (native-path "tree" "sub1" "deep") labels))))))
  (with-du (lambda (t)
    (test-assert "test_du_sort_orders_largest_first" (sorted-desc? (du-sizes (out t "du -d 1 -b --sort tree"))))))
  (with-du (lambda (t)
    (test-assert "test_du_all_includes_files"
                 (member (native-path "tree" "a.txt") (du-labels (out t "du -a -d 1 -b tree"))))))
  (with-du (lambda (t)
    (let ((labels (du-labels (out t "du -d 1 -b --threshold=1K tree"))))
      (test-assert "test_du_threshold_filters sub2" (not (member (native-path "tree" "sub2") labels)))
      (test-assert "test_du_threshold_filters sub1" (member (native-path "tree" "sub1") labels)))))
  (with-du (lambda (t)
    (test-assert "test_du_missing_path" (contains? (err t "du nope") "ERR"))))
  (with-du (lambda (t)
    (test-assert "test_du_default_path_is_cwd" (string-ends? (out t "du -s -b") "."))))
  (with-du (lambda (t)
    (test-equal "du order" (list (native-path "tree" "sub1" "deep") (native-path "tree" "sub1")
                                 (native-path "tree" "sub2") "tree")
                (du-labels (out t "du -b tree")))
    (test-equal "du bad option" "ERR: du: unknown option '-x'" (err t "du -x tree"))
    (test-equal "du bad threshold" "ERR: du: invalid size 'abc'" (err t "du --threshold=abc tree"))
    (test-equal "du bad depth" "ERR: du: invalid depth 'z'" (err t "du -d z tree")))))

;; ── TestFindHash ────────────────────────────────────────────────────────

(define (with-find proc)
  (with-shell (lambda (t)
    (mkdir t "tree/sub")
    (write-file t "tree/a.txt" "alpha")
    (write-file t "tree/b.py" "beta")
    (write-file t "tree/sub/c.txt" "gamma")
    (proc t))))

(test-group "find"
  (with-find (lambda (t)
    (let ((items (lines (out t "find tree"))))
      (test-assert "test_find_default_lists_all tree" (member "tree" items))
      (test-assert "test_find_default_lists_all a" (member (native-path "tree" "a.txt") items))
      (test-assert "test_find_default_lists_all sub" (member (native-path "tree" "sub") items))
      (test-assert "test_find_default_lists_all c" (member (native-path "tree" "sub" "c.txt") items)))))
  (with-find (lambda (t)
    (let ((items (lines (out t "find tree -name *.txt"))))
      (test-assert "test_find_name_glob a" (member (native-path "tree" "a.txt") items))
      (test-assert "test_find_name_glob c" (member (native-path "tree" "sub" "c.txt") items))
      (test-assert "test_find_name_glob b" (not (member (native-path "tree" "b.py") items))))))
  (with-find (lambda (t)
    (let ((items (lines (out t "find tree -type d"))))
      (test-assert "test_find_type_filter tree" (member "tree" items))
      (test-assert "test_find_type_filter sub" (member (native-path "tree" "sub") items))
      (test-assert "test_find_type_filter a" (not (member (native-path "tree" "a.txt") items))))))
  (with-find (lambda (t)
    (let ((items (lines (out t "find tree -maxdepth 1"))))
      (test-assert "test_find_maxdepth a" (member (native-path "tree" "a.txt") items))
      (test-assert "test_find_maxdepth c" (not (member (native-path "tree" "sub" "c.txt") items))))))
  (with-find (lambda (t)
    (write-file t "tree/UPPER.TXT" "x")
    (test-assert "test_find_iname" (member (native-path "tree" "UPPER.TXT") (lines (out t "find tree -iname *.txt"))))))
  (with-find (lambda (t)
    (test-equal "find order"
                (list "tree" (native-path "tree" "a.txt") (native-path "tree" "b.py")
                      (native-path "tree" "sub") (native-path "tree" "sub" "c.txt"))
                (lines (out t "find tree")))
    (test-equal "find -type error" "ERR: find: -type must be f or d, got 'x'" (err t "find -type x"))
    (test-equal "find unknown option" "ERR: find: unknown option '-foo'" (err t "find -foo"))
    (test-equal "find missing" "ERR: nope not found" (err t "find nope"))
    (test-equal "find -name without value" "ERR: find: -name requires an argument" (err t "find tree -name"))
    (test-equal "find -maxdepth invalid" "ERR: find: invalid maxdepth 'x'" (err t "find tree -maxdepth x"))))
  ;; bug fix: an entry whose name starts with ".." is below the cwd
  (with-find (lambda (t)
    (write-file t "..dots" "x")
    (test-equal "find ..name is relative" "..dots" (out t "find ..dots"))))
  (with-find (lambda (t)
    (shell-cwd-set! (tc-shell t) (file-path t "tree/sub"))
    (test-equal "find above cwd is absolute" (file-path t (native-path "tree" "b.py"))
                (out t (string-append "find " (file-path t "tree") " -name b.py"))))))

(test-group "hash"
  (with-shell (lambda (t)
    (write-file t "h.txt" "hello\n")
    (let ((o (out t "hash h.txt")))
      (test-assert "test_hash_sha256_default"
                   (contains? o "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03"))
      (test-assert "test_hash_sha256_default name" (contains? o "h.txt")))
    (test-assert "test_hash_md5" (contains? (out t "hash -a md5 h.txt") "b1946ac92492d2347c6235b4d2611184"))
    (test-equal "hash sha1" "f572d396fae9206628714fb2ce00f72e94f2258f  h.txt" (out t "hash -a SHA1 h.txt"))
    (test-equal "hash sha512"
                "e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629  h.txt"
                (out t "hash -a sha512 h.txt"))
    (test-equal "hash sha384"
                "1d0f284efe3edea4b9ca3bd514fa134b17eae361ccc7a1eefeff801b9bd6604e01f21f6bf249ef030599f0c218f2ba8c  h.txt"
                (out t "hash -a sha384 h.txt"))
    (test-equal "hash sha512 empty"
                "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
                (sha512-hex (bytevector)))
    (test-equal "hash sha512 two blocks"
                "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"
                (sha512-hex (string->utf8 "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")))
    (test-assert "test_hash_unknown_algo" (contains? (err t "hash -a md9 h.txt") "ERR"))
    (test-assert "test_hash_missing_file" (contains? (err t "hash nope.txt") "ERR"))
    (test-equal "test_hash_pipe_stdin"
                "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03"
                (out t "echo hello | hash")))))

;; ── TestFileOps ─────────────────────────────────────────────────────────

(test-group "file ops"
  (with-shell (lambda (t)
    (run-cmd t "touch newfile.txt")
    (test-assert "test_touch_creates_file" (is-file? t "newfile.txt"))))
  (with-shell (lambda (t)
    (write-file t "old.txt" "x")
    (set-file-modification-time! (file-path t "old.txt") 1000000000000)
    (run-cmd t "touch old.txt")
    (test-assert "test_touch_updates_timestamp" (> (mtime t "old.txt") 1000000000000))
    (test-equal "touch keeps content" "x" (read-text t "old.txt"))))
  (with-shell (lambda (t)
    (run-cmd t "mkdir newdir")
    (test-assert "test_mkdir_creates_directory" (is-dir? t "newdir"))))
  (with-shell (lambda (t)
    (run-cmd t "mkdir a/b/c")
    (test-assert "test_mkdir_nested" (is-dir? t (native-path "a" "b" "c")))
    (write-file t "f" "x")
    (test-assert "mkdir on a file" (contains? (err t "mkdir f") "already exists"))))
  (with-shell (lambda (t)
    (write-file t "src.txt" "content")
    (run-cmd t "cp src.txt dst.txt")
    (test-equal "test_cp_copies_file" "content" (read-text t "dst.txt"))))
  (with-shell (lambda (t)
    (write-file t "src.txt" "hi")
    (run-cmd t "mkdir destdir")
    (run-cmd t "cp src.txt destdir")
    (test-assert "test_cp_to_directory" (is-file? t (native-path "destdir" "src.txt")))
    (test-assert "cp onto itself" (contains? (err t "cp src.txt src.txt") "same file"))
    (test-equal "cp onto itself keeps content" "hi" (read-text t "src.txt"))
    (test-assert "cp missing source" (contains? (err t "cp nope.txt destdir") "not found"))))
  (with-shell (lambda (t)
    (write-file t "orig.txt" "data")
    (run-cmd t "mv orig.txt renamed.txt")
    (test-assert "test_mv_renames_file gone" (not (exists? t "orig.txt")))
    (test-assert "test_mv_renames_file new" (is-file? t "renamed.txt"))))
  (with-shell (lambda (t)
    (write-file t "a.txt" "new")
    (write-file t "d/a.txt" "old")
    (run-cmd t "mv a.txt d")
    (test-equal "mv replaces file in directory" "new" (read-text t (native-path "d" "a.txt")))
    (test-assert "mv replaces file in directory, source gone" (not (exists? t "a.txt")))
    (mkdir t "x/y")
    (run-cmd t "mv x d")
    (test-assert "mv directory into directory" (is-dir? t (native-path "d" "x" "y")))
    (mkdir t "x")
    (test-assert "mv directory onto existing" (contains? (err t "mv x d") "already exists"))
    (test-assert "mv directory into itself" (contains? (err t "mv d d/x") "into itself"))))
  (with-shell (lambda (t)
    (write-file t "todelete.txt" "x")
    (run-cmd t "rm todelete.txt")
    (test-assert "test_rm_deletes_file" (not (exists? t "todelete.txt")))))
  (with-shell (lambda (t)
    (mkdir t "adir")
    (test-assert "test_rm_nonexistent_gives_error" (contains? (err t "rm adir") "ERR"))
    (test-equal "rm without match is silent" "" (err t "rm nothing.txt"))))
  (with-shell (lambda (t)
    (mkdir t "mydir")
    (run-cmd t "rmdir mydir")
    (test-assert "test_rmdir_removes_directory" (not (exists? t "mydir")))))
  (with-shell (lambda (t)
    (mkdir t "outer/inner")
    (write-file t "outer/inner/f.txt" "x")
    (run-cmd t "rmdir outer")
    (test-assert "test_rmdir_recursive" (not (exists? t "outer")))
    (write-file t "f.txt" "x")
    (test-assert "rmdir on a file" (contains? (err t "rmdir f.txt") "is a file"))
    (test-assert "rmdir missing" (contains? (err t "rmdir nope") "not found")))))

;; bug fix: a glob with several matches needs a directory as destination
(test-group "cp/mv several matches to a file"
  (with-shell (lambda (t)
    (write-file t "a.txt" "a")
    (write-file t "b.txt" "b")
    (test-equal "cp glob to new file" "ERR: cannot copy multiple files to a file" (err t "cp *.txt new.txt"))
    (test-assert "cp glob to new file creates nothing" (not (exists? t "new.txt")))
    (test-equal "mv glob to new file" "ERR: cannot move multiple files to a file" (err t "mv *.txt new.txt"))
    (test-assert "mv glob keeps sources" (and (exists? t "a.txt") (exists? t "b.txt"))))))

